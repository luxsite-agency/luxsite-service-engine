{% extends '@EasyAdmin/page/content.html.twig' %}
{% block content_title %}{{ title }}{% endblock %}
{% block main %}
    <p>{{ description }}</p>
    {{ form_start(form) }}
        {{ form_widget(form) }}
        <button class="btn btn-primary" type="submit">{{ title }}</button>
        <a class="btn btn-secondary" href="{{ detail_url }}">Скасувати</a>
    {{ form_end(form) }}
{% endblock %}
