{# Картка статті в списках контентного сайту: post, locale; heading — h2|h3; thumb — мініатюра обкладинки (прев'ю зображень
   бренду, sv_thumbs у шаблоні сторінки; без обкладинки — без мініатюри); eager — без lazy (перша картка над першим екраном) #}
<article class="c-post">
    {% if thumb|default(false) and post.imageName %}<a href="{{ path('sv_blog_post', {slug: post.slug(locale)}) }}" tabindex="-1"><img src="{{ asset('media/service_post/' ~ post.imageName)|imagine_filter('item_hero_sm') }}" alt="{{ post.imageAlt(locale) ?? post.loc('title', locale) }}" width="460" height="307"{% if not eager|default(false) %} loading="lazy"{% endif %}></a>{% endif %}
    <div class="in">
        <{{ heading|default('h2') }}><a href="{{ path('sv_blog_post', {slug: post.slug(locale)}) }}">{{ post.loc('title', locale) }}</a></{{ heading|default('h2') }}>
        <p class="c-meta">
            {%- if post.publishedAt %}<time datetime="{{ post.publishedAt|date('Y-m-d') }}">{{ sv_date(post.publishedAt, locale) }}</time>{% endif %}
            {%- if post.category and post.category.existsIn(locale) %} · <a href="{{ path('sv_blog_category', {slug: post.category.slug(locale)}) }}">{{ post.category.loc('title', locale) }}</a>{% endif -%}
        </p>
        {% set _lead = post.loc('lead', locale)|striptags|trim %}
        {% if _lead %}<p>{{ _lead|length > 220 ? _lead|slice(0, 220) ~ '…' : _lead }}</p>{% endif %}
    </div>
</article>
