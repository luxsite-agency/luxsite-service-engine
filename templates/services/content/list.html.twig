{# Список статей контентного сайту: увесь блог, рубрика (category) або автор (author). #}
{% extends 'services/content/layout.html.twig' %}

{# locale задає base.html.twig, а він рендериться пізніше за верхній рівень дочірнього шаблону #}
{% set locale = sv_locale() %}

{% set _brand = site.brandName(locale) ?? site.name %}
{% if category %}
    {% set _h1 = category.loc('title', locale) %}
    {% set _title = category.loc('metaTitle', locale) ?? (_h1 ~ ' - ' ~ _brand) %}
    {% set _desc = category.loc('metaDesc', locale) ?? category.loc('desc', locale)|striptags|slice(0, 160) %}
    {% set _route, _params = 'sv_blog_category', {slug: category.slug(locale)} %}
{% elseif author %}
    {% set _h1 = author.name %}
    {% set _title = author.name ~ ' - ' ~ _brand %}
    {% set _desc = author.loc('bio', locale)|striptags|slice(0, 160) %}
    {% set _route, _params = 'sv_author', {slug: author.slug} %}
{% else %}
    {% set _h1 = 'blog.h1'|trans({}, 'servicesite') %}
    {% set _title = _h1 ~ ' - ' ~ _brand %}
    {% set _desc = city.loc('metaDesc', locale) %}
    {% set _route, _params = 'sv_blog', {} %}
{% endif %}

{% block title %}{{ _title }}{% if page > 1 %}{{ 'blog.page_suffix'|trans({'%page%': page}, 'servicesite') }}{% endif %}{% endblock %}

{% block metaDescription %}{{ _desc }}{% endblock %}

{% block meta %}
    {% set _pageRoute = category ? 'sv_blog_category_page' : 'sv_blog_page' %}
    {% if page > 1 %}<link rel="prev" href="{{ page == 2 ? url(_route, _params|merge({_locale: locale})) : url(_pageRoute, _params|merge({page: page - 1, _locale: locale})) }}">{% endif %}
    {% if page < pages %}<link rel="next" href="{{ url(_pageRoute, _params|merge({page: page + 1, _locale: locale})) }}">{% endif %}
{% endblock %}

{% block schema %}
    {% import 'services/partials/_schema.html.twig' as schema %}
    {% set _crumbs = [{'name': 'common.breadcrumb_home'|trans({}, 'servicesite'), 'url': url('sv_home', {_locale: locale})}] %}
    {% if category or author %}{% set _crumbs = _crumbs|merge([{'name': 'nav.blog'|trans({}, 'servicesite'), 'url': url('sv_blog', {_locale: locale})}]) %}{% endif %}
    {{ schema.crumbs(_crumbs|merge([{'name': _h1}])) }}
    {% if author %}
        {% set _person = {'@context': 'https://schema.org', '@type': 'Person', 'name': author.name, 'url': url('sv_author', {slug: author.slug, _locale: locale})} %}
        {% if author.loc('role', locale) %}{% set _person = _person|merge({'jobTitle': author.loc('role', locale)}) %}{% endif %}
        {% if author.imageName %}{% set _person = _person|merge({'image': app.request.schemeAndHttpHost ~ '/media/service_author/' ~ author.imageName}) %}{% endif %}
        {{ schema.ld(_person) }}
    {% endif %}
{% endblock %}

{% block body %}
    <nav class="breadcrumbs">
        <a href="{{ path('sv_home') }}">{{ 'common.breadcrumb_home'|trans({}, 'servicesite') }}</a> →
        {% if category or author %}<a href="{{ path('sv_blog') }}">{{ 'nav.blog'|trans({}, 'servicesite') }}</a> →{% endif %}
        {{ _h1 }}
    </nav>
    {% if author %}
    <div class="c-author">
        {% if author.imageName %}<img src="/media/service_author/{{ author.imageName }}" alt="{{ author.name }}" width="72" height="72">{% endif %}
        <div>
            <h1>{{ author.name }}</h1>
            {% if author.loc('role', locale) %}<p class="c-meta">{{ author.loc('role', locale) }}</p>{% endif %}
            {% if author.loc('bio', locale) %}<div>{{ author.loc('bio', locale)|raw }}</div>{% endif %}
        </div>
    </div>
    {% else %}
    <h1>{{ _h1 }}</h1>
    {% if category and category.loc('desc', locale) %}<div>{{ category.loc('desc', locale)|raw }}</div>{% endif %}
    {% endif %}

    {% if not author and categories is not empty %}
    <ul class="c-cats">
        {% for c in categories %}<li><a href="{{ path('sv_blog_category', {slug: c.slug(locale)}) }}"{% if category and c.id == category.id %} aria-current="page"{% endif %}>{{ c.loc('title', locale) }}</a></li>{% endfor %}
    </ul>
    {% endif %}

    <div class="c-posts">
        {% for post in posts %}{% include 'services/content/_card.html.twig' with {heading: 'h2'} %}{% endfor %}
    </div>

    {% if pages > 1 %}
    {% set _pageRoute = category ? 'sv_blog_category_page' : 'sv_blog_page' %}
    <nav class="c-pages" aria-label="{{ 'blog.pagination'|trans({}, 'servicesite') }}">
        {% if page > 1 %}<a href="{{ page == 2 ? path(_route, _params) : path(_pageRoute, _params|merge({page: page - 1})) }}">{{ 'blog.prev'|trans({}, 'servicesite') }}</a>{% endif %}
        {% if page < pages %}<a href="{{ path(_pageRoute, _params|merge({page: page + 1})) }}">{{ 'blog.next'|trans({}, 'servicesite') }}</a>{% endif %}
    </nav>
    {% endif %}
{% endblock %}
