{# Стаття контентного сайту: рубрика, теги (рядок посилань під текстом, keywords у JSON-LD), автор (Person у JSON-LD),
   видавець — Organization бренду. #}
{% extends 'services/content/layout.html.twig' %}

{# locale задає base.html.twig, а він рендериться пізніше за верхній рівень дочірнього шаблону #}
{% set locale = sv_locale() %}

{% set _brand = site.brandName(locale) ?? site.name %}
{% set _cat = post.category and post.category.existsIn(locale) ? post.category : null %}
{% set _author = post.author and post.author.active ? post.author : null %}
{% set _tags = post.tagsIn(locale) %}

{% block title %}{{ post.loc('metaTitle', locale) ?? (post.loc('title', locale) ~ ' - ' ~ _brand) }}{% endblock %}

{% block metaDescription %}{{ (post.loc('metaDesc', locale) ?? post.loc('lead', locale))|striptags|slice(0, 300) }}{% endblock %}
{% block ogType %}article{% endblock %}
{% block ogImage %}{{ post.imageName ? '/media/service_post/' ~ post.imageName : (theme.url('og_image') ?? '') }}{% endblock %}

{% block schema %}
    {% import 'services/partials/_schema.html.twig' as schema %}
    {% set _url = altUrls[locale] ?? app.request.uri %}
    {% set _crumbs = [
        {'name': 'common.breadcrumb_home'|trans({}, 'servicesite'), 'url': url('sv_home', {_locale: locale})},
        {'name': 'nav.blog'|trans({}, 'servicesite'), 'url': url('sv_blog', {_locale: locale})},
    ] %}
    {% if _cat %}{% set _crumbs = _crumbs|merge([{'name': _cat.loc('title', locale), 'url': url('sv_blog_category', {slug: _cat.slug(locale), _locale: locale})}]) %}{% endif %}
    {{ schema.crumbs(_crumbs|merge([{'name': post.loc('title', locale)}])) }}
    {% set _publisher = {'@type': 'Organization', 'name': _brand, 'url': url('sv_home', {_locale: locale})} %}
    {% if theme.url('logo') %}{% set _publisher = _publisher|merge({'logo': {'@type': 'ImageObject', 'url': app.request.schemeAndHttpHost ~ theme.url('logo')}}) %}{% endif %}
    {% set art = {
        '@context': 'https://schema.org',
        '@type': 'BlogPosting',
        'headline': post.loc('title', locale)|slice(0, 110),
        'url': _url,
        'mainEntityOfPage': {'@type': 'WebPage', '@id': _url},
        'inLanguage': sv_locale_code(locale, 'schema'),
        'author': _author ? {'@type': 'Person', 'name': _author.name, 'url': url('sv_author', {slug: _author.slug, _locale: locale})} : {'@type': 'Organization', 'name': _brand},
        'publisher': _publisher,
    } %}
    {% if post.loc('lead', locale) %}{% set art = art|merge({'description': post.loc('lead', locale)|striptags}) %}{% endif %}
    {% if post.publishedAt %}{% set art = art|merge({'datePublished': post.publishedAt|date('c'), 'dateModified': (post.updatedAt ?? post.publishedAt)|date('c')}) %}{% endif %}
    {% if post.imageName %}{% set art = art|merge({'image': app.request.schemeAndHttpHost ~ '/media/service_post/' ~ post.imageName}) %}{% endif %}
    {% if _cat %}{% set art = art|merge({'articleSection': _cat.loc('title', locale)}) %}{% endif %}
    {% if _tags is not empty %}{% set art = art|merge({'keywords': _tags|map(t => t.loc('title', locale))}) %}{% endif %}
    {{ schema.ld(art) }}
{% endblock %}

{% block body %}
    <nav class="breadcrumbs">
        <a href="{{ path('sv_home') }}">{{ 'common.breadcrumb_home'|trans({}, 'servicesite') }}</a> →
        <a href="{{ path('sv_blog') }}">{{ 'nav.blog'|trans({}, 'servicesite') }}</a> →
        {% if _cat %}<a href="{{ path('sv_blog_category', {slug: _cat.slug(locale)}) }}">{{ _cat.loc('title', locale) }}</a> →{% endif %}
        {{ post.loc('title', locale) }}
    </nav>
    <article class="c-article">
        <h1>{{ post.loc('title', locale) }}</h1>
        <p class="c-meta">
            {%- if post.publishedAt %}<time datetime="{{ post.publishedAt|date('Y-m-d') }}">{{ sv_date(post.publishedAt, locale) }}</time>{% endif %}
            {%- if _author %} · <a href="{{ path('sv_author', {slug: _author.slug}) }}" rel="author">{{ _author.name }}</a>{% endif -%}
        </p>
        {% if post.imageName %}<img class="c-cover" src="/media/service_post/{{ post.imageName }}" alt="{{ post.imageAlt(locale) ?? post.loc('title', locale) }}" width="1200" height="675">{% endif %}
        {% if post.loc('lead', locale) %}<p><strong>{{ post.loc('lead', locale)|striptags }}</strong></p>{% endif %}
        {% if post.loc('desc', locale) %}<div class="c-text">{{ post.loc('desc', locale)|raw }}</div>{% endif %}
        {% if _tags is not empty %}
        <p class="c-tags"><span>{{ 'blog.tags'|trans({}, 'servicesite') }}:</span>{% for t in _tags %} <a href="{{ path('sv_blog_tag', {slug: t.slug(locale)}) }}" rel="tag">{{ t.loc('title', locale) }}</a>{% endfor %}</p>
        {% endif %}
        {% if _author %}
        <aside class="c-author">
            {% if _author.imageName %}<img src="/media/service_author/{{ _author.imageName }}" alt="{{ _author.name }}" width="72" height="72" loading="lazy">{% endif %}
            <div>
                <p><a href="{{ path('sv_author', {slug: _author.slug}) }}"><strong>{{ _author.name }}</strong></a>{% if _author.loc('role', locale) %} · {{ _author.loc('role', locale) }}{% endif %}</p>
                {% if _author.loc('bio', locale) %}<div>{{ _author.loc('bio', locale)|raw }}</div>{% endif %}
            </div>
        </aside>
        {% endif %}
    </article>
{% endblock %}
