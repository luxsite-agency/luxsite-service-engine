{# Контакти контентного сайту: лише форма зв'язку (ім'я, email, повідомлення) → /lead, без телефонів, адрес і месенджерів. #}
{% extends 'services/content/layout.html.twig' %}

{% block title %}{{ 'contact.title'|trans({}, 'servicesite') }} - {{ site.brandName(locale) ?? site.name }}{% endblock %}

{% block metaDescription %}{{ 'contact.intro'|trans({}, 'servicesite') }}{% endblock %}

{% block schema %}
    {% import 'services/partials/_schema.html.twig' as schema %}
    {{ schema.crumbs([
        {'name': 'common.breadcrumb_home'|trans({}, 'servicesite'), 'url': url('sv_home', {_locale: locale})},
        {'name': 'contact.title'|trans({}, 'servicesite')},
    ]) }}
{% endblock %}

{% block body %}
    <nav class="breadcrumbs">
        <a href="{{ path('sv_home') }}">{{ 'common.breadcrumb_home'|trans({}, 'servicesite') }}</a> →
        {{ 'contact.title'|trans({}, 'servicesite') }}
    </nav>
    <h1>{{ 'contact.title'|trans({}, 'servicesite') }}</h1>
    <p>{{ 'contact.intro'|trans({}, 'servicesite') }}</p>
    {% for msg in app.flashes('lead_error') %}<p class="c-error" role="alert">{{ msg }}</p>{% endfor %}
    <form class="c-form" method="post" action="{{ path('sv_lead') }}">
        <input type="hidden" name="_token" value="{{ csrf_token('sv_lead') }}">
        <input type="hidden" name="lead_type" value="contact">
        {# honeypot: заповнюють лише боти #}
        <input type="text" name="website" value="" tabindex="-1" autocomplete="off" aria-hidden="true" style="position:absolute;left:-9999px">
        <label>{{ 'lead.name'|trans({}, 'servicesite') }}<input type="text" name="name" maxlength="128" autocomplete="name"></label>
        <label>{{ 'contact.email'|trans({}, 'servicesite') }}<input type="email" name="email" maxlength="190" required autocomplete="email"></label>
        <label>{{ 'contact.message'|trans({}, 'servicesite') }}<textarea name="message" rows="6" maxlength="3000" required></textarea></label>
        <p class="c-meta">{{ 'contact.privacy_note'|trans({'%url%': path('sv_privacy')}, 'servicesite')|raw }}</p>
        <button class="btn" type="submit">{{ 'contact.submit'|trans({}, 'servicesite') }}</button>
    </form>
{% endblock %}
