{# RSS 2.0 контентного сайту (FeedController): items — підготовлені масиви (title, link, guid, pubDate, description, category,
   image, imageType, imageLength); channelLink, selfUrl, lastBuild. Обкладинка — enclosure (з довжиною файлу) і media:content. -#}
<?xml version="1.0" encoding="UTF-8"?>
{% set locale = sv_locale() %}
{% set _brand = site.brandName(locale) ?? site.name %}
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom" xmlns:media="http://search.yahoo.com/mrss/">
<channel>
    <title>{{ category ? _brand ~ ': ' ~ category.loc('title', locale) : _brand }}</title>
    <link>{{ channelLink }}</link>
    <description>{{ category ? category.loc('title', locale) ~ ' — ' ~ _brand : _brand }}</description>
    <language>{{ locale }}</language>
    <lastBuildDate>{{ lastBuild }}</lastBuildDate>
    <atom:link href="{{ selfUrl }}" rel="self" type="application/rss+xml"/>
{% for item in items %}
    <item>
        <title>{{ item['title'] }}</title>
        <link>{{ item['link'] }}</link>
        <guid isPermaLink="false">{{ item['guid'] }}</guid>
        <pubDate>{{ item['pubDate'] }}</pubDate>
{% if item['description'] %}
        <description>{{ item['description'] }}</description>
{% endif %}
{% if item['category'] %}
        <category>{{ item['category'] }}</category>
{% endif %}
{% if item['image'] %}
{% if item['imageLength'] %}
        <enclosure url="{{ item['image'] }}" length="{{ item['imageLength'] }}" type="{{ item['imageType'] }}"/>
{% endif %}
        <media:content url="{{ item['image'] }}" medium="image" type="{{ item['imageType'] }}"/>
{% endif %}
    </item>
{% endfor %}
</channel>
</rss>
