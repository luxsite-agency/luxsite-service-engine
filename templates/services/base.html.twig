        <script>
            // плаваюча CTA ховається, коли футер у в'юпорті (не налазить на низ сторінки)
            (function () {
                var cta = document.querySelector('.floating-cta');
                var footer = document.querySelector('footer.site');
                if (!cta || !footer) return;
                var update = function () {
                    cta.classList.toggle('hidden', footer.getBoundingClientRect().top < window.innerHeight);
                };
                window.addEventListener('scroll', update, { passive: true });
                window.addEventListener('resize', update);
                update();
            })();
        </script>
        {#~ Банер згоди на cookie (адмінка → Налаштування → «Банер згоди на cookie»): показується, поки нема cookie sv_consent;
            «Прийняти» — consent update granted і старт Clarity/Pixel (svTags 'consent'), «Відхилити» — denied. 180 днів. #}
        {%~ if _svTags.consentBanner %}
        <div id="sv-consent" role="dialog" aria-live="polite" aria-label="{{ 'consent.title'|trans({}, 'servicesite') }}" hidden style="position:fixed;left:12px;right:12px;bottom:12px;z-index:10000;max-width:760px;margin:0 auto;background:#fff;color:#1a1f24;border:1px solid var(--border, #d5dce3);border-radius:14px;box-shadow:0 10px 30px rgba(0,0,0,.15);padding:14px 18px;display:flex;flex-wrap:wrap;gap:10px 14px;align-items:center;font-size:.95rem">
            <span style="flex:1 1 280px">{{ 'consent.text'|trans({}, 'servicesite') }} <a href="{{ path('sv_privacy') }}">{{ 'consent.more'|trans({}, 'servicesite') }}</a></span>
            <button type="button" class="btn" data-consent="granted">{{ 'consent.accept'|trans({}, 'servicesite') }}</button>
            <button type="button" class="btn btn-ghost" data-consent="denied">{{ 'consent.decline'|trans({}, 'servicesite') }}</button>
        </div>
        <script>
            (function () {
                var b = document.getElementById('sv-consent');
                if (!b || /(?:^|;\s*)sv_consent=/.test(document.cookie)) { return; }
                b.hidden = false;
                b.addEventListener('click', function (e) {
                    var t = e.target.closest('[data-consent]');
                    if (!t) { return; }
                    var v = t.getAttribute('data-consent') === 'granted' ? 'granted' : 'denied';
                    document.cookie = 'sv_consent=' + v + ';path=/;max-age=15552000;SameSite=Lax' + (location.protocol === 'https:' ? ';Secure' : '');
                    window.dataLayer = window.dataLayer || [];
                    if (window.gtag) { gtag('consent', 'update', {ad_storage: v, ad_user_data: v, ad_personalization: v, analytics_storage: v}); }
                    window.dataLayer.push({event: 'consent_update', consent: v});
                    if (v === 'granted' && window.svTags) { svTags.go('consent'); }
                    b.remove();
                });
            })();
        </script>
        {%~ endif %}
        {#~ Свій код перед </body> (адмінка → Налаштування → HTML-коди; лише адміністратор): сирим, як збережено. #}
        {%~ if _svTags.htmlBodyEnd %}
        {{ _svTags.htmlBodyEnd|raw }}
        {%~ endif %}
    </body>
</html>
