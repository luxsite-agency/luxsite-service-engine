{# Каркас сервісного профілю. Дизайн перенесено з Joomla-шаблону першого імпортованого сайту:
   білий фон, акцентний колір з теми паку (SiteTheme: app.theme.colors, дефолт
   помаранчевий #f98111) з градієнтом, pill-кнопки CTA,
   топбар години/email/телефон, бенефіти-іконки, muted-секції #f2f6f8,
   бордери #d5dce3. Контролери передають altUrls = {uk, ru} — з нього
   будуються hreflang, canonical і перемикач мов. -#}
{% set locale = app.request.locale == 'ru' ? 'ru' : 'uk' %}
{#~ Аналітика й коди сайту (site_tags: лічильник міста > GTM/GA4/Ads з адмінки → Налаштування; Clarity і верифікація —
   адмінка > пак). Без налаштувань значення ті самі, що давали city.gtmId, app.clarity_id і app.site_verification. #}
{%~ set _svTags = site_tags(city) %}
<!DOCTYPE html>
<html lang="{{ locale }}">
    <head>
        <meta charset="UTF-8">
        {% block meta_generator %}<meta name="generator" content="LuxSite Service Engine">{% endblock ~%}
        <meta name="viewport" content="width=device-width, initial-scale=1">
        {# Підтвердження прав у Search Console (адмінка → Налаштування > app.site_verification паку; Bing — лише адмінка). Саме тут,
           а не через GTM: перевірник Google не виконує JavaScript, тому тег, вставлений
           менеджером тегів, він просто не побачить. Покриває всі хости бренду, бо шаблон спільний. -#}
        {% if _svTags.googleVerification %}<meta name="google-site-verification" content="{{ _svTags.googleVerification }}">{% endif %}{% if _svTags.bingVerification %}<meta name="msvalidate.01" content="{{ _svTags.bingVerification }}">{% endif ~%}
        {# app.page_meta паку перекриває title/description фіксованих сторінок (паритет після міграції) -#}
        {% set _pmTitle = page_meta('title') ~%}
        <title>{% if _pmTitle %}{{ _pmTitle }}{% else %}{% block title %}{{ site.name }}{% endblock %}{% endif %}</title>
        {# фавікони - з теми паку (public/themes/<key>/); без теми тегів нема -#}
        {% if theme.url('favicon_ico') %}<link rel="icon" href="{{ theme.url('favicon_ico') }}" sizes="32x32">{% endif ~%}
        {% if theme.url('favicon_png') %}<link rel="icon" type="image/png" href="{{ theme.url('favicon_png') }}" sizes="192x192">{% endif ~%}
        {% if theme.url('apple_touch_icon') %}<link rel="apple-touch-icon" href="{{ theme.url('apple_touch_icon') }}">{% endif ~%}
        {# pageNoindex — сторінка, однакова на всіх хостах, поза індексом лише на цьому місті (юридичні: app.legal_noindex_cities) -#}
        {% if city.noindex %}<meta name="robots" content="noindex, nofollow">{% elseif pageNoindex|default(false) %}<meta name="robots" content="noindex, follow">{% endif ~%}
        {# canonicalUrls приходить лише там, де сторінка однакова в усіх містах
           (блог): тоді і canonical, і hreflang ведуть на головний домен, щоб
           чотири копії не конкурували між собою. Перемикач мов у підвалі
           лишається на altUrls - він має тримати людину на своєму хості. -#}
        {% set _canon = canonicalUrls|default(null) ?: (altUrls|default(null)) %}
        {% if _canon and _canon[locale] is defined %}
        <link rel="canonical" href="{{ _canon[locale] }}">
        {% endif %}
        {% if _canon and _canon.uk is defined and _canon.ru is defined %}
        <link rel="alternate" hreflang="uk-UA" href="{{ _canon.uk }}">
        <link rel="alternate" hreflang="ru-UA" href="{{ _canon.ru }}">
        <link rel="alternate" hreflang="x-default" href="{{ _canon.uk }}">
        {% endif %}
        {# опис сторінки: один блок живить і <meta description>, і og:description -#}
        {% set _desc %}{% block metaDescription %}{% endblock %}{% endset %}
        {% set _desc = _desc|striptags|trim|replace({
            '&nbsp;': ' ', '&#039;': "'", '&#39;': "'", '&quot;': '"',
            '&lt;': '<', '&gt;': '>', '&amp;': '&',
        }) %}
        {% set _desc = page_meta('desc') ?? _desc %}
        {% if _desc %}<meta name="description" content="{{ _desc }}">{% endif ~%}
        {# og:image за замовчуванням - з теми паку; без теми - ілюстрація хіро бренду -#}
        {% set _ogImage %}{% block ogImage %}{{ theme.url('og_image') ?? theme.url('hero_image') ?? site.heroImagePath ?? '' }}{% endblock %}{% endset %}
        {% set _ogImage = _ogImage|trim ~%}
        <meta property="og:type" content="{% block ogType %}website{% endblock %}">
        <meta property="og:title" content="{{ (_pmTitle ?: block('title'))|striptags|trim }}">
        {% if _desc %}<meta property="og:description" content="{{ _desc }}">{% endif ~%}
        <meta property="og:url" content="{{ _canon[locale]|default(app.request.uri) }}">
        <meta property="og:site_name" content="{{ site.name }}">
        <meta property="og:locale" content="{{ locale == 'ru' ? 'ru_UA' : 'uk_UA' }}">
        {% if _ogImage %}<meta property="og:image" content="{{ _ogImage starts with 'http' ? _ogImage : app.request.schemeAndHttpHost ~ _ogImage }}">{% endif ~%}
        <meta name="twitter:card" content="{{ _ogImage ? 'summary_large_image' : 'summary' }}">
        {% block meta %}{% endblock %}
        {% block schema %}{% endblock %}
        {% block stylesheets %}
        <style>
            :root {
                /* кольори бренду - з теми паку (app.theme.colors): accent, accent2, accent-ink
                   (текстовий відтінок акценту з контрастом 4.5+ на білому), dark, navy, footer-bg,
                   footer-line, footer-text; решта - спільні для всіх сайтів */
                {{ theme.cssVars()|raw }}
                --text: #2b3134; --muted-text: #48474c; --border: #d5dce3; --bg-muted: #f2f6f8; --radius: 12px;
            }
            * { box-sizing: border-box; }
            body { font-family: 'Segoe UI', system-ui, -apple-system, sans-serif; margin: 0; color: var(--text); background: #fff; font-size: 16px; line-height: 1.55; }
            a { color: var(--accent-ink); }
            .container { max-width: 1200px; margin: 0 auto; padding: 0 1rem; }
            h1, h2, h3 { color: var(--dark); line-height: 1.25; }
            h1 { font-size: 2.3rem; font-weight: 800; margin: 1.2rem 0 .8rem; }
            h2 { font-size: 1.6rem; font-weight: 700; }
            /* підпис службового блоку (не заголовок розділу): виглядає як h2 */
            .block-title { font-size: 1.6rem; font-weight: 700; color: var(--dark);
                line-height: 1.25; margin: 1.4rem 0 .8rem; }
            .btn { display: inline-block; background: linear-gradient(90deg, var(--accent), var(--accent2)); color: #fff; padding: .7rem 1.8rem; border-radius: 999px; text-decoration: none; border: 0; cursor: pointer; font-size: 1rem; font-weight: 600; box-shadow: 0 6px 14px color-mix(in srgb, var(--accent) 35%, transparent); transition: box-shadow .15s, transform .15s; }
            .btn:hover { box-shadow: 0 8px 18px color-mix(in srgb, var(--accent) 50%, transparent); transform: translateY(-1px); }
            /* - Топбар - */
            .topbar { background: var(--bg-muted); border-bottom: 1px solid var(--border); font-size: .88rem; color: var(--muted-text); }
            .topbar .container { display: flex; align-items: center; gap: 1.4rem; padding-top: .55rem; padding-bottom: .55rem; flex-wrap: wrap; }
            .topbar a { color: var(--muted-text); text-decoration: none; }
            .topbar a.phone { font-weight: 700; color: var(--text); }
            .topbar .ico { color: var(--accent); margin-right: .3rem; }
            /* месенджери міста (partials/_messengers): крапка в кольорі бренду месенджера */
            a.msgr { font-weight: 600; text-decoration: none; white-space: nowrap; }
            a.msgr .ico { margin-right: .3rem; }
            a.msgr-viber .ico { color: #7360f2; } a.msgr-telegram .ico { color: #2aabee; } a.msgr-whatsapp .ico { color: #25d366; }
            .modal-msgrs { margin: 0; padding: 0 1.6rem 1.2rem; display: flex; gap: 1rem; flex-wrap: wrap; align-items: center; color: var(--muted-text); font-size: .92rem; }
            .modal-msgrs a.msgr { color: var(--text); }
            .city-switch { position: relative; }
            .city-switch summary { display: inline-flex; align-items: center; gap: .1rem; cursor: pointer; list-style: none;
                font-weight: 600; color: var(--text); padding: .15rem .1rem; }
            .city-switch summary::-webkit-details-marker { display: none; }
            .city-switch summary::after { content: '▾'; margin-left: .35rem; color: var(--muted-text); font-size: .8rem; }
            .city-switch[open] summary::after { content: '▴'; }
            .city-switch ul { position: absolute; z-index: 30; top: calc(100% + .45rem); left: 0; margin: 0; padding: .35rem;
                list-style: none; min-width: 190px; background: #fff; border: 1px solid var(--border);
                border-radius: var(--radius); box-shadow: 0 10px 24px rgba(16, 39, 44, .14); }
            .city-switch li a, .city-switch li span { display: block; padding: .5rem .7rem; border-radius: 8px; font-size: .92rem; }
            .city-switch li a { color: var(--text); text-decoration: none; }
            .city-switch li a:hover { background: var(--bg-muted); color: var(--accent-ink); }
            .city-switch li span.active { color: var(--muted-text); cursor: default; }
            .topbar .btn { margin-left: auto; padding: .45rem 1.3rem; font-size: .88rem; }
            /* - Шапка: бренд + нав - */
            .brandbar .container { display: flex; align-items: center; gap: 1rem; padding-top: .8rem; padding-bottom: .8rem; }
            .brand { display: flex; align-items: center; gap: .6rem; text-decoration: none; }
            .brand .logo { width: 42px; height: 42px; display: flex; align-items: center; justify-content: center; }
            .brand .logo img { width: 42px; height: 42px; object-fit: contain; display: block; }
            /* без лого в темі - квадрат у кольорах бренду з першою літерою назви */
            .brand .logo.logo-letter { border-radius: 10px; background: linear-gradient(135deg, var(--accent), var(--accent2)); color: #fff; font-size: 1.4rem; font-weight: 800; }
            .brand .name { font-size: 1.45rem; font-weight: 800; color: var(--dark); letter-spacing: -.02em; }
            .brand .tagline { display: block; font-size: .72rem; font-weight: 400; color: var(--muted-text); letter-spacing: 0; }
            .navbar { border-top: 1px solid var(--border); border-bottom: 1px solid var(--border); }
            .navbar .container { display: flex; align-items: center; gap: .2rem; flex-wrap: wrap; }
            .navbar nav { display: flex; flex-wrap: wrap; }
            .navbar nav a { color: var(--text); text-decoration: none; padding: .8rem .9rem; font-weight: 600; font-size: .95rem; }
            .navbar nav a:hover { color: var(--accent); }
            .lang-switch--m { display: none; }
            .burger { display: none; flex-direction: column; justify-content: center; gap: 5px; width: 44px; height: 44px; padding: 0 10px; background: none; border: 0; cursor: pointer; }
            .burger span { display: block; height: 2px; background: var(--dark); border-radius: 2px; transition: transform .2s, opacity .2s; }
            .burger[aria-expanded="true"] span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
            .burger[aria-expanded="true"] span:nth-child(2) { opacity: 0; }
            .burger[aria-expanded="true"] span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }
            .lang-switch { margin-left: auto; font-weight: 700; font-size: .9rem; }
            .lang-switch a { text-decoration: none; color: var(--muted-text); margin-left: .5rem; }
            .lang-switch a.active { color: var(--accent-ink); }
            main { padding: .5rem 0 1.5rem; }
            /* - Хіро/бенефіти - */
            .hero { display: flex; gap: 2.5rem; align-items: center; flex-wrap: wrap; }
            .hero-content { flex: 1 1 420px; min-width: 0; width: 100%; }
            .hero-img { flex: 0 1 420px; margin: 0; text-align: center; }
            .hero-img figcaption { margin-top: .4rem; line-height: 1.3; }
            .hero-img figcaption b { display: block; color: var(--dark); font-size: 1.05rem; }
            .hero-img figcaption span { color: var(--muted-text); font-size: .88rem; }
            .hero-img img { width: 100%; height: auto; display: block; }
            .hero-img img { border-radius: var(--radius); }
            /* пагінація списку блогу (/blog/page/N/) */
            .pagination { display: flex; flex-wrap: wrap; gap: .4rem; align-items: center; margin: 1.5rem 0; }
            .pagination a, .pagination .pg-cur, .pagination .pg-gap { min-width: 2.2rem; padding: .4rem .6rem; text-align: center; border-radius: var(--radius); border: 1px solid var(--line, #d5dce3); text-decoration: none; }
            .pagination .pg-cur { background: var(--accent); color: #fff; border-color: var(--accent); font-weight: 700; }
            .pagination .pg-gap { border: 0; min-width: auto; }
            /* лічильники під ілюстрацією хіро (ключі паку hero.stat*_value/label; порожні = блоку нема) */
            .hero-stats { display: flex; gap: 1.25rem; justify-content: center; flex-wrap: wrap; margin: .9rem 0 0; padding: 0; list-style: none; }
            .hero-stats li { text-align: center; min-width: 6.5rem; }
            .hero-stats b { display: block; font-size: 1.5rem; line-height: 1.1; color: var(--accent-ink); }
            .hero-stats span { display: block; font-size: .82rem; color: var(--muted-text); line-height: 1.25; }
            .hero-actions { display: flex; flex-wrap: wrap; gap: .7rem; align-items: center; }
            .btn-ghost { background: none; color: var(--accent-ink); border: 2px solid var(--accent);
                box-shadow: none; padding: calc(.7rem - 2px) 1.6rem; }
            .btn-ghost:hover { background: var(--accent); color: #fff; }
            .hero-sub { font-size: 1.05rem; color: var(--muted-text); margin: 0 0 1.4rem; max-width: 70ch; }
            .hero-sub p { margin: 0 0 .6rem; }
            .hero-sub p:last-child { margin-bottom: 0; }
            .benefits { display: grid; grid-template-columns: repeat(auto-fit, minmax(165px, 1fr)); gap: 1rem 1.2rem; margin: 1.6rem 0; }
            .benefit { display: flex; align-items: center; gap: .6rem; font-size: .88rem; line-height: 1.35; color: var(--muted-text); }
            .benefit .bico { flex: 0 0 auto; width: 38px; height: 38px; border: 2px solid var(--accent); border-radius: 50%; color: var(--accent); display: flex; align-items: center; justify-content: center; font-size: 1.15rem; }
            /* - Секції/картки - */
            section.block { margin: 3.2rem 0; }
            section.block:first-child { margin-top: 1rem; }
            /* повноширинна сіра смуга (full-bleed з центрованого контейнера) */
            section.block.muted { background: var(--bg-muted); margin-left: calc(50% - 50vw); margin-right: calc(50% - 50vw); padding: 2.4rem calc(50vw - 50%); }
            /* центровані заголовки секцій */
            section.block.center > h2:first-child { text-align: center; font-size: 1.8rem; margin: 0 0 1.6rem; }
            body { overflow-x: hidden; }
            .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(255px, 1fr)); gap: 1.1rem; }
            /* --- стрічка відгуків: скрол по горизонталі + розкривання --- */
            /* широкий банер, не постер: обкладинка на всю ширину, але
               низька, щоб не з'їдати перший екран. Однаково для району
               й статті - формат у них спільний */
            .district-cover, .post-cover {
                width: 100%; height: clamp(160px, 24vw, 300px); object-fit: cover;
                border-radius: 8px; margin: 1.2rem 0 .6rem;
            }
            .reviews-strip { position: relative; }
            .reviews-row {
                display: flex; gap: 1.1rem; overflow-x: auto; scroll-behavior: smooth;
                /* без scroll-snap: коли лишається прогорнути менше, ніж
                   ширина картки, снап тягнув стрічку назад на початок
                   і стрілка «вперед» не давала жодного руху */
                padding: .2rem; margin: 0 -.2rem;
                /* смугу прокрутки ховаємо: гортання дають стрілки й палець,
                   а сама смуга під картками виглядала як службовий елемент */
                scrollbar-width: none; -ms-overflow-style: none;
            }
            .reviews-row::-webkit-scrollbar { width: 0; height: 0; }
            .reviews-grid {
                display: grid; grid-template-columns: repeat(auto-fill, minmax(270px, 1fr));
                gap: 1.1rem; align-items: stretch;
            }
            .review-card { display: flex; flex-direction: column; text-align: left; }
            /* ширину задає лише стрічка; у сітці її диктує колонка */
            .reviews-row .review-card { flex: 0 0 clamp(240px, 78vw, 320px); }
            .review-card .card-name { display: flex; align-items: center; gap: .6rem; }
            .review-card .card-name img { width: 44px; height: 44px; object-fit: cover; border-radius: 50%; }
            .review-card .stars { color: var(--accent); font-size: .9rem; }
            .review-card .meta { margin: 0 0 .5rem; }
            .review-text { margin: 0; white-space: pre-line; }
            /* обрізаємо лише коли JS підтвердив, що текст справді довший */
            .review-text.is-clamped {
                display: -webkit-box; -webkit-line-clamp: 8; -webkit-box-orient: vertical;
                overflow: hidden;
            }
            .review-more {
                align-self: flex-start; margin-top: .6rem; padding: 0; border: 0; background: none;
                font: inherit; font-size: .92rem; font-weight: 600; color: var(--accent-ink); /* accent-ink: контраст 4.5+ на білому (a11y) */
                cursor: pointer; text-decoration: underline;
            }
            .reviews-nav {
                position: absolute; top: 50%; transform: translateY(-50%); z-index: 2;
                width: 40px; height: 40px; border-radius: 50%; border: 1px solid var(--border);
                background: #fff; color: var(--dark); font-size: 1.5rem; line-height: 1;
                cursor: pointer; box-shadow: 0 4px 14px rgba(43, 49, 52, .12);
            }
            .reviews-nav:hover { color: var(--accent); border-color: var(--accent); }
            .reviews-nav.is-edge { opacity: .35; }
            /* на десктопі стрічці лишаємо поля під стрілки, щоб кнопка
               стояла в порожньому місці, а не поверх тексту відгуку */
            @media (min-width: 721px) {
                .reviews-strip:not(.is-grid) { padding: 0 52px; }
                .reviews-nav.prev { left: 0; }
                .reviews-nav.next { right: 0; }
            }
            @media (max-width: 720px) { .reviews-nav { display: none; } }
            .card { border: 1px solid var(--border); border-radius: var(--radius); padding: 1.1rem 1.2rem; background: #fff; transition: box-shadow .15s; }
            .card:hover { box-shadow: 0 8px 22px rgba(43, 49, 52, .08); }
            .card h3, .card .card-name { margin: 0 0 .5rem; font-size: 1.08rem;
                font-weight: 700; color: var(--dark); line-height: 1.25; }
            .card a { color: var(--dark); text-decoration: none; }
            .card a:hover { color: var(--accent); }
            .card ul { margin: .3rem 0 0; padding-left: 1.1rem; }
            .card li { margin: .25rem 0; }
            .card li a { color: var(--muted-text); font-weight: 400; }
            /* - Прайс - */
            /* Прайс на головній показується повністю: запит там загальний,
               і людині потрібен весь перелік, а не один таб. Чіпи згори -
               швидкі переходи до потрібної послуги. */
            .price-jump { margin-bottom: 1.4rem; }
            .prices-calc-link { margin: .4rem 0 0; }

            .price-pane { margin-bottom: 2rem; scroll-margin-top: 80px; }
            .price-pane-title { margin: 0 0 .2rem; font-size: 1.08rem; text-align: left; }
            .price-pane-title a { color: var(--dark); text-decoration: none; }
            .price-pane-title a:hover { color: var(--accent); text-decoration: underline; }
            /* характеристики послуги (тип авто): таблиця на сторінці й компактний список у картці категорії */
            table.specs { border-collapse: collapse; margin: .6rem 0; }
            table.specs th, table.specs td { text-align: left; padding: .45rem 1.2rem .45rem 0; border-bottom: 1px solid var(--border); vertical-align: top; }
            table.specs th { font-weight: 600; color: var(--dark); }
            .card-specs { display: grid; grid-template-columns: auto 1fr; gap: .2rem .7rem; margin: .5rem 0 0; font-size: .9rem; }
            .card-specs dt { color: var(--muted-text); } .card-specs dd { margin: 0; }
            table.prices { width: 100%; border-collapse: collapse; margin: 1rem 0; }
            table.prices td, table.prices th { border-bottom: 1px solid var(--border); padding: .65rem .7rem; text-align: left; }
            table.prices tr:nth-child(odd) td { background: var(--bg-muted); }
            table.prices td.price { white-space: nowrap; font-weight: 700; color: var(--dark); }
            /* - Наші роботи: сітка власних фото - */
            .works-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 1rem; }
            .work-card { margin: 0; border: 1px solid var(--border); border-radius: 10px; overflow: hidden; background: #fff; }
            .work-card img { display: block; width: 100%; height: auto; aspect-ratio: 16 / 9; object-fit: cover; }
            .work-card figcaption { padding: .6rem .8rem .75rem; font-size: .93rem; color: var(--dark); }
            .work-card figcaption .meta { display: block; margin-top: .15rem; font-size: .84rem; color: var(--muted-text); }
            {#- сторінки app.pages: галерея сканів (А4 книжкою, без обрізання), додаткові поля #}
            .page-gallery .work-card img { aspect-ratio: 210 / 297; object-fit: contain; background: #fff; }
            .page-fields { display: grid; grid-template-columns: max-content 1fr; gap: .35rem 1.2rem; margin: 1.2rem 0; }
            .page-fields dt { font-weight: 600; } .page-fields dd { margin: 0; }
            /* «до/після» - дві половини одного кадру, підпис поверх знімка */
            .work-pair { display: grid; grid-template-columns: 1fr 1fr; gap: 2px; }
            .work-shot { position: relative; display: block; }
            .work-shot b { position: absolute; left: .4rem; bottom: .4rem; padding: .1rem .5rem; border-radius: 999px; font-size: .78rem; background: rgba(255, 255, 255, .88); color: var(--dark); }

            /* - Шеврон-іконка акордеонів (оригінал uk-accordion, у нашому акценті) - */
            /* колір шеврона - акцент теми: SVG як маска, заливка через background-color (у data-URI var() не працює) */
            .acc-chevron::after { content: ''; width: 26px; height: 26px; background-color: var(--accent); -webkit-mask: url("data:image/svg+xml;charset=utf-8,%3Csvg%20xmlns%3D%27http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%27%20width%3D%2732%27%20height%3D%2732%27%20fill%3D%27%23000%27%3E%3Cpath%20d%3D%27M16%2030a14%2014%200%201%201%200-28%2014%2014%200%200%201%200%2028m0-26a12%2012%200%201%200%200%2024%2012%2012%200%200%200%200-24m0%2017.4-7-7%201.4-1.4%205.6%205.6%205.6-5.6%201.4%201.4z%27%2F%3E%3C%2Fsvg%3E") no-repeat 50% 50% / cover; mask: url("data:image/svg+xml;charset=utf-8,%3Csvg%20xmlns%3D%27http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%27%20width%3D%2732%27%20height%3D%2732%27%20fill%3D%27%23000%27%3E%3Cpath%20d%3D%27M16%2030a14%2014%200%201%201%200-28%2014%2014%200%200%201%200%2028m0-26a12%2012%200%201%200%200%2024%2012%2012%200%200%200%200-24m0%2017.4-7-7%201.4-1.4%205.6%205.6%205.6-5.6%201.4%201.4z%27%2F%3E%3C%2Fsvg%3E") no-repeat 50% 50% / cover; }
            details[open] > summary.acc-chevron::after { -webkit-mask-image: url("data:image/svg+xml;charset=utf-8,%3Csvg%20xmlns%3D%27http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%27%20width%3D%2732%27%20height%3D%2732%27%20fill%3D%27%23000%27%3E%3Cpath%20d%3D%27M16%2030a14%2014%200%201%201%200-28%2014%2014%200%200%201%200%2028m0-26a12%2012%200%201%200%200%2024%2012%2012%200%200%200%200-24m0%207.6-7%207%201.4%201.4%205.6-5.6%205.6%205.6%201.4-1.4z%27%2F%3E%3C%2Fsvg%3E"); mask-image: url("data:image/svg+xml;charset=utf-8,%3Csvg%20xmlns%3D%27http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%27%20width%3D%2732%27%20height%3D%2732%27%20fill%3D%27%23000%27%3E%3Cpath%20d%3D%27M16%2030a14%2014%200%201%201%200-28%2014%2014%200%200%201%200%2028m0-26a12%2012%200%201%200%200%2024%2012%2012%200%200%200%200-24m0%207.6-7%207%201.4%201.4%205.6-5.6%205.6%205.6%201.4-1.4z%27%2F%3E%3C%2Fsvg%3E"); }
            /* - FAQ-акордеон - */
            details.faq { border: 1px solid var(--border); border-radius: 10px; padding: .8rem 1.1rem; margin: .6rem 0; background: #fff; }
            details.faq summary { cursor: pointer; font-weight: 700; color: var(--dark); list-style: none; display: flex; align-items: center; justify-content: space-between; gap: .8rem; }
            details.faq summary::after { flex: 0 0 auto; }
            details.faq > div { padding-top: .6rem; color: var(--muted-text); }
            /* - Чипси районів - */
            .chips { display: flex; flex-wrap: wrap; gap: .5rem; }
            .chips a { border: 1px solid var(--border); border-radius: 999px; padding: .35rem .95rem; text-decoration: none; color: var(--muted-text); font-size: .9rem; background: #fff; }
            .chips a:hover { border-color: var(--accent); color: var(--accent-ink); }
            /* клас використовувався в шаблоні, але правила не було - чипи стояли
               ліворуч під центрованим заголовком */
            .chips-center { justify-content: center; }
            .chips a.more { border-color: var(--accent); color: var(--accent-ink); font-weight: 600; }
            /* «Усі питання» під FAQ головної — як чип .more */
            a.faq-all { display: inline-block; margin-top: .6rem; padding: .35rem .9rem; border: 1px solid var(--accent); border-radius: 999px; color: var(--accent-ink); font-weight: 600; text-decoration: none; }
            /* міні-калькулятор унизу головної: параметри ліворуч, підсумок праворуч */
            .calc-mini { background: var(--bg-muted); border: 1px solid var(--border); border-radius: var(--radius); padding: 1.6rem; }
            .calc-mini-body { display: grid; grid-template-columns: minmax(0, 1fr) 280px; gap: 1.6rem 2rem; align-items: start; }
            .calc-mini-params { display: grid; gap: 1.1rem; }
            .calc-mini-label { display: flex; justify-content: space-between; align-items: baseline; gap: .5rem; font-size: .78rem; text-transform: uppercase; letter-spacing: .05em; color: var(--muted-text); margin-bottom: .45rem; }
            .calc-mini-label output { font-size: 1rem; font-weight: 700; color: var(--dark); text-transform: none; letter-spacing: 0; }
            .calc-chips { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: .45rem; }
            .calc-chips-wide { grid-template-columns: repeat(auto-fit, minmax(190px, 1fr)); }
            .calc-chips button { font: inherit; font-size: .92rem; line-height: 1.25; padding: .6rem .9rem; border: 1px solid var(--border); border-radius: 10px; background: #fff; color: var(--text); cursor: pointer; text-align: left; transition: border-color .15s, color .15s; }
            .calc-chips button:hover { border-color: var(--accent); color: var(--accent-ink); }
            .calc-chips button.active { background: var(--accent-ink); border-color: var(--accent-ink); color: #fff; font-weight: 600; }
            .calc-mini-area { display: flex; align-items: center; gap: .9rem; }
            .calc-mini-area input[type=range] { flex: 1 1 auto; accent-color: var(--accent); }
            .calc-mini-area input[type=number] { width: 90px; padding: .55rem .6rem; border: 1px solid var(--border); border-radius: 10px; text-align: center; font-size: 1rem; }
            .calc-mini-result { display: flex; flex-direction: column; gap: .55rem; background: #fff; border: 1px solid var(--border); border-radius: var(--radius); padding: 1.2rem; }
            .calc-mini-result-label { font-size: .78rem; text-transform: uppercase; letter-spacing: .05em; color: var(--muted-text); }
            .calc-mini-price { margin: 0; color: var(--dark); font-size: 1rem; }
            .calc-mini-price b { font-size: 2rem; font-weight: 800; letter-spacing: -.02em; }
            .calc-mini-recap { margin: 0; font-size: .85rem; color: var(--muted-text); line-height: 1.4; }
            .calc-mini-result .btn { text-align: center; width: 100%; }
            .calc-mini-result input[type=tel], .calc-mini-result input[type=text] {
                padding: .6rem .9rem; border: 1px solid var(--border); border-radius: 999px;
                font-size: 1rem; background: #fff; width: 100%; }
            .calc-mini-result input:focus { outline: 2px solid var(--accent2); border-color: transparent; }
            .calc-mini-full { color: var(--accent-ink); font-size: .9rem; text-align: center; }
            .calc-mini-note { font-size: .78rem; color: var(--muted-text); line-height: 1.35; }
            @media (max-width: 820px) {
                .calc-mini { padding: 1.1rem; }
                .calc-mini-body { grid-template-columns: 1fr; }
            }
            .chips a.active { background: linear-gradient(90deg, var(--accent), var(--accent2)); color: #fff; border-color: transparent; font-weight: 600; }
            /* - Акордеон «Де ми працюємо» - */
            .district-groups { border: 1px solid var(--border); border-radius: var(--radius); padding: .6rem 1.4rem; display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 0 2.5rem; background: #fff; }
            .district-groups details { padding: .55rem 0; border-bottom: 1px solid var(--bg-muted); }
            .district-groups summary { cursor: pointer; font-weight: 600; color: var(--dark); list-style: none; display: flex; align-items: center; justify-content: space-between; gap: .8rem; }
            .district-groups summary::after { flex: 0 0 auto; }
            .district-groups .chips { padding: .7rem 0 .3rem; }
            /* одна група в блоці (передмістя) - розтягуємо на всю ширину,
               інакше сітка лишає її в колонці 280px і поруч порожньо */
            .district-groups details:only-child { grid-column: 1 / -1; }
            /* - СЕО-картки - */
            .seo-text .seo-card { border: 1px solid var(--border); border-radius: var(--radius); padding: 1.4rem 1.6rem; margin: 1.2rem 0; background: #fff; }
            .seo-text .seo-card h2 { margin-top: 0; font-size: 1.35rem; }
            .seo-text .seo-card p { color: var(--muted-text); }
            .seo-text .seo-card ul { list-style: none; padding: 0; margin: .8rem 0; }
            .seo-text .seo-card li { position: relative; padding-left: 1.7rem; margin: .45rem 0; color: var(--muted-text); }
            .seo-text .seo-card li::before { content: '✔'; position: absolute; left: 0; color: var(--accent-ink); font-weight: 700; }
            .legal-text { max-width: 760px; }
            .legal-text h2 { font-size: 1.15rem; margin: 1.6rem 0 .5rem; }
            .legal-text p, .legal-text li { line-height: 1.7; }
            .legal-text ul { margin: .4rem 0 .9rem 1.1rem; }
            .contacts-cols { display: grid; grid-template-columns: 1fr 1fr; gap: 1.2rem; align-items: stretch; margin-top: 1.4rem; }
            .contacts-cols > section.block { margin: 0; }
            .contacts-card { background: var(--bg-muted); border: 1px solid var(--border); border-radius: var(--radius);
                padding: 1.5rem 1.6rem; display: flex; flex-direction: column; justify-content: center; gap: .5rem; }
            .contacts-card p { margin: 0; }
            .contacts-card .meta { margin-top: .4rem; }
            .map-block { padding: 0; overflow: hidden; border-radius: var(--radius); border: 1px solid var(--border); min-height: 320px; display: flex; flex-direction: column; }
            .map-canvas { flex: 1 1 auto; display: flex; min-height: 280px; }
            .map-block iframe { width: 100%; height: 100%; min-height: 280px; border: 0; display: block; }
            .map-link { display: block; padding: .7rem 1rem; text-align: center; font-size: .9rem; font-weight: 600;
                background: #fff; border-top: 1px solid var(--border); text-decoration: none; }
            .map-link:hover { background: var(--bg-muted); }
            .map-facade { flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: .35rem;
                background: var(--bg-muted); border: 0; cursor: pointer; font: inherit; color: var(--dark); padding: 1.5rem; }
            .map-facade:hover { background: #e6f2f3; }
            .map-pin { font-size: 1.9rem; color: var(--accent); line-height: 1; }
            .map-facade-title { font-weight: 700; }
            .map-facade-hint { font-size: .85rem; color: var(--muted-text); }
            @media (max-width: 760px) { .contacts-cols { grid-template-columns: 1fr; } }
            /* - Список блогу: рядок з мініатюрою, на телефоні - колонка - */
            .post-card { display: flex; gap: 1.2rem; align-items: flex-start; margin-bottom: 1rem; }
            .post-card .post-thumb { flex: 0 0 220px; max-width: 220px; display: block; }
            .post-card .post-thumb img { width: 100%; height: auto; aspect-ratio: 1200 / 630;
                object-fit: cover; border-radius: 8px; display: block; }
            .post-card .post-body { min-width: 0; }
            .post-card h3 { margin: 0 0 .3rem; font-size: 1.15rem; line-height: 1.35; }
            .post-card h3 a { color: var(--dark); text-decoration: none; }
            .post-card h3 a:hover { color: var(--accent-ink); }
            .post-card .meta { margin: 0 0 .5rem; }
            .post-card p:last-child { margin-bottom: 0; }
            @media (max-width: 640px) {
                .post-card { flex-direction: column; gap: .85rem; }
                .post-card .post-thumb { flex: 1 1 auto; max-width: none; width: 100%; }
                .post-card h3 { font-size: 1.05rem; }
            }
            .breadcrumbs { font-size: .85rem; color: var(--muted-text); margin: .8rem 0 0; }
            .breadcrumbs a { color: var(--muted-text); text-decoration: none; }
            .breadcrumbs a:hover { color: var(--accent); }
            .meta { color: var(--muted-text); font-size: .85rem; }
            /* - Форма заявки - */
            .lead-form { background: var(--bg-muted); border-radius: var(--radius); padding: 1.6rem; }
            .lead-form .form-sub { margin: -.5rem 0 1rem; color: var(--muted-text); max-width: 720px; }
            .lead-form .lead-msgrs { margin: 1rem 0 0; display: flex; gap: 1rem; flex-wrap: wrap; align-items: center; color: var(--muted-text); }
            .lead-form .lead-msgrs a.msgr { color: var(--text); }
            .lead-form .form-title { font-size: 1.6rem; font-weight: 700; color: var(--dark);
                line-height: 1.25; margin: 0 0 .8rem; }
            .lead-form input[type=tel], .lead-form input[type=text] { padding: .65rem .9rem; border: 1px solid var(--border); border-radius: 999px; font-size: 1rem; background: #fff; }
            .lead-form input:focus { outline: 2px solid var(--accent2); border-color: transparent; }
            /* - Модалка + плаваюча CTA - */
            dialog.lead-modal { border: 0; border-radius: var(--radius); padding: 0; max-width: 560px; width: calc(100% - 2rem); box-shadow: 0 20px 60px rgba(0,0,0,.3); }
            dialog.lead-modal::backdrop { background: rgba(8, 49, 58, .55); }
            dialog.lead-modal .lead-form { border-radius: 0; }
            dialog.lead-modal .close { position: absolute; top: .6rem; right: .9rem; background: none; border: 0; font-size: 1.5rem; cursor: pointer; color: var(--muted-text); }
            .floating-cta { position: fixed; right: 1.2rem; bottom: 1.2rem; z-index: 50; transition: opacity .2s, transform .2s; }
            .floating-cta.hidden { opacity: 0; transform: translateY(10px); pointer-events: none; }
            /* - Футер - */
            body { min-height: 100vh; display: flex; flex-direction: column; }
            main { flex: 1 0 auto; }
            footer.site { flex-shrink: 0; background: var(--footer-bg); color: var(--footer-ink); border-top: 1px solid var(--footer-line); padding: 1.8rem 0; margin-top: 2.5rem; font-size: .9rem; }
            footer.site a { color: var(--footer-ink); text-decoration: none; }
            footer.site a:hover { color: var(--accent); }
            footer.site .container > p { color: var(--footer-text); }
            footer.site .container > p a { text-decoration: underline; }
            footer.site nav a { font-weight: 600; }
            /* каталог у футері (app.footer_catalog) */
            .footer-catalog { margin: 0 0 1.4rem; padding-bottom: 1.2rem; border-bottom: 1px solid var(--footer-line); }
            .footer-catalog-title { margin: 0 0 .8rem; font-weight: 700; font-size: 1rem; color: var(--footer-ink); }
            .footer-catalog-cols { display: grid; grid-template-columns: repeat(auto-fit, minmax(210px, 1fr)); gap: .8rem 1.6rem; }
            /* target-size (Lighthouse): summary і посилання ≥24px по висоті з відступом */
            .footer-cat summary { font-weight: 600; cursor: pointer; list-style: none; padding: .45rem 0; min-height: 24px; }
            .footer-cat summary::-webkit-details-marker { display: none; }
            .footer-cat ul { list-style: none; margin: .2rem 0 .6rem; padding: 0; }
            .footer-cat li { margin: 0; font-size: .85rem; line-height: 1.35; }
            footer.site .footer-cat li a { color: var(--footer-text); display: inline-block; padding: .35rem 0; min-height: 24px; }
            .footer-cat summary > a { display: inline-block; min-height: 24px; line-height: 24px; }
            @media (max-width: 759px) { .footer-cat summary::after { content: ' ▾'; color: var(--footer-text); } .footer-cat[open] summary::after { content: ' ▴'; } }
            .footer-address, .footer-cities { margin: .4rem 0 0; color: var(--footer-text); }
            .footer-copyright { margin: .8rem 0 0; font-size: .8rem; color: var(--footer-text); max-width: 780px; }
            .footer-legal { margin: 1.2rem 0 0; padding-top: .85rem; border-top: 1px solid var(--footer-line); font-size: .8rem; color: var(--footer-text); }
            footer.site .footer-legal a { color: var(--footer-text); text-decoration: underline; }
            footer.site .footer-legal a:hover { color: var(--accent); }
            footer.site nav { display: flex; flex-wrap: wrap; gap: 1rem; margin-bottom: .8rem; }
            @media (max-width: 700px) {
                h1 { font-size: 1.6rem; }
                .topbar .hide-m { display: none; }
                /* у топбарі на мобільному лишається тільки телефон: кнопка дублюється плаваючою */
                .topbar .btn { display: none; }
                .benefits { grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: .8rem; }
                /* сендвіч-меню: лого, мови і кнопка стоять одним рядком */
                .burger { display: flex; margin-left: auto; margin-right: -10px; }
                .lang-switch--m { display: inline-flex; margin-left: auto; }
                .navbar .lang-switch { display: none; }
                .brandbar { border-bottom: 1px solid var(--border); }
                .navbar { border-top: 0; border-bottom: 0; }
                .navbar .container { padding: 0 1rem; }
                .navbar nav { display: none; width: 100%; flex-direction: column; padding-bottom: .4rem; }
                .navbar nav.open { display: flex; }
                .navbar nav a { padding: .85rem .2rem; border-bottom: 1px solid var(--border); }
            }
        </style>
        {% endblock %}
        {# CSS теми паку: inline у <style> (app.theme.stylesheet_inline — без render-blocking запиту) або <link> з ?v= -#}
        {% set _inlineCss = theme.inlineCss() %}
        {% if _inlineCss %}<style>{{ _inlineCss|raw }}</style>
        {% elseif theme.url('stylesheet') %}<link rel="stylesheet" href="{{ theme.url('stylesheet') }}">{% endif %}
        {# живий CSS під токеном менеджера (ThemeService, theme.css) — після стилів рушія й паку -#}
        {% if theme.liveCssUrl() %}<link rel="stylesheet" href="{{ theme.liveCssUrl() }}">{% endif %}
        <script>
            var FORM_MSG = {
                required: {{ 'form.required'|trans({}, 'servicesite')|json_encode|raw }},
                phone: {{ 'form.phone'|trans({}, 'servicesite')|json_encode|raw }}
            };
            document.addEventListener('invalid', function (e) {
                var el = e.target;
                if (!el.setCustomValidity) { return; }
                if (el.validity.valueMissing) {
                    el.setCustomValidity(el.type === 'tel' ? FORM_MSG.phone : FORM_MSG.required);
                } else if (el.validity.typeMismatch || el.validity.patternMismatch) {
                    el.setCustomValidity(FORM_MSG.phone);
                }
            }, true);
            document.addEventListener('input', function (e) {
                if (e.target.setCustomValidity) { e.target.setCustomValidity(''); }
            }, true);
            document.addEventListener('click', function (e) {
                var burger = e.target.closest('.burger');
                if (!burger) { return; }
                var nav = document.getElementById('site-nav');
                var open = nav.classList.toggle('open');
                document.body.classList.toggle('nav-open', open);
                burger.setAttribute('aria-expanded', open ? 'true' : 'false');
            });
        </script>
        {% block javascripts %}{% endblock %}
        {#~ Черга svTags і Consent Mode (адмінка → Налаштування: Meta Pixel, конверсія Ads, GA4 сайту, банер згоди) — поза
            block analytics, щоб пак, який перекриває аналітику, не загубив згоду. Без цих налаштувань нічого не виводиться. #}
        {%~ if _svTags.runtime %}
        <script>{{ _svTags.runtimeJs|raw }}</script>
        {%~ endif %}
        {% block analytics %}
        {# Який саме код вставляти, вирішує site_tags(city): лічильник міста (GTM-… - контейнер Tag Manager, G-…/AW-… -
           лічильник напряму; у поле можна вставити цілий сніпет Google) > GTM сайту з адмінки → Налаштування; GA4 і Ads
           сайту — gtag.js на сторінках без GTM. Clarity: адмінка > app.clarity_id паку. -#}
        {% if analytics_defer and (_svTags.kind or _svTags.clarityId or _svTags.pixelId) %}
        {# app.analytics_defer: GTM/gtag і Clarity стартують після window.load + 800 мс (таймер — пасивні візити рахуються,
           вимога /analytics-healthcheck) або раніше на першу взаємодію; прапорець проти подвійного старту. dataLayer.push
           до старту лягає в чергу, яку контейнер підхопить, тож phone_click/generate_lead не губляться. PSI сайту
           з Joomla-імпортом: 310 КБ gtm+gtag у ланцюжку LCP → +1,0–1,4 с render delay; з відкладенням 69–75 → 89–94. -#}
        <script>
        (function () {
            window.dataLayer = window.dataLayer || [];
            {% if _svTags.kind == 'gtag' %}window.gtag = window.gtag || function () { window.dataLayer.push(arguments); };{% endif %}
            var started = false;
            function start() {
                if (started) { return; }
                started = true;
                {% if _svTags.kind == 'gtm' %}
