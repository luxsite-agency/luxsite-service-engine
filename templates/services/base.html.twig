        <script>
            /* Джерело заявки. Мітки приходять на першій сторінці візиту, а форму
               людина часто відправляє вже з іншої - тому кладемо в localStorage
               і підставляємо в приховані поля перед відправкою. Прямий захід
               збережену рекламну мітку не затирає. */
            (function () {
                /* ключ спільний для всіх сайтів рушія; старі ключі форків (pc_src, el_src)
                   дочитуються, щоб не втратити мітки відвідувачів за 90 днів після переїзду */
                var KEY = 'sv_src', TTL = 7776e6; /* 90 днів */
                var LEGACY_KEYS = ['pc_src', 'el_src'];
                var q = new URLSearchParams(location.search);
                var UTM = ['utm_source', 'utm_medium', 'utm_campaign', 'utm_content', 'utm_term'];
                var click = q.get('gclid') || q.get('fbclid') || q.get('ttclid') || '';
                var fresh = click !== '' || UTM.some(function (k) { return q.get(k); });

                var saved = null;
                try { saved = JSON.parse(localStorage.getItem(KEY) || 'null'); } catch (e) {}
                if (saved && Date.now() - (saved.t || 0) > TTL) { saved = null; }

                if (fresh || !saved) {
                    var ref = document.referrer || '';
                    if (ref.indexOf(location.origin) === 0) { ref = ''; }
                    var data = {t: Date.now(), click_id: click, referrer: ref.slice(0, 500),
                                landing_url: location.href.slice(0, 500)};
                    UTM.forEach(function (k) { data[k] = q.get(k) || ''; });
                    try { localStorage.setItem(KEY, JSON.stringify(data)); } catch (e) {}
                    saved = data;
                }
                if (!saved) {
                    LEGACY_KEYS.forEach(function (k) {
                        if (saved) { return; }
                        try { saved = JSON.parse(localStorage.getItem(k) || 'null'); } catch (e) {}
                    });
                }
                if (!saved) { return; }

                var fields = UTM.concat(['click_id', 'referrer', 'landing_url']);
                function fill(form) {
                    fields.forEach(function (name) {
                        if (!saved[name] || form.querySelector('[name="' + name + '"]')) { return; }
                        var input = document.createElement('input');
                        input.type = 'hidden';
                        input.name = name;
                        input.value = saved[name];
                        form.appendChild(input);
                    });
                }
                /* У момент відправки, а не при завантаженні: модалка із формою
                   лежить у розмітці нижче за цей скрипт, тож на старті її ще
                   немає в DOM - і саме звідти йде більшість заявок. Capture,
                   щоб устигнути до самої відправки.
                   Тут же захист від подвійного натискання (перенесено з першого сайту на рушії):
                   друга відправка тієї ж форми глушиться, кнопка гасне до переходу
                   на подяку (було по дві однакові заявки з інтервалом 1-3 с). */
                document.addEventListener('submit', function (e) {
                    var form = e.target;
                    if (!form || !form.matches || !form.matches('form[data-lead-form]')) { return; }
                    if (form.dataset.sent === '1') { e.preventDefault(); return; }
                    form.dataset.sent = '1';
                    fill(form);
                    var btn = form.querySelector('[type="submit"]');
                    if (btn) { btn.disabled = true; btn.style.opacity = '.6'; }
                    /* якщо мережа впала й сторінка лишилась - дати відправити знову */
                    setTimeout(function () {
                        form.dataset.sent = '';
                        if (btn) { btn.disabled = false; btn.style.opacity = ''; }
                    }, 15000);
                }, true);
            })();
        </script>
        <script>
            /* Події для GTM: клік по номеру - єдиний спосіб бачити дзвінки без
               платного колтрекінгу, тож шлемо з тими самими мітками джерела. */
            (function () {
                window.dataLayer = window.dataLayer || [];
                var src = {};
                try { src = JSON.parse(localStorage.getItem('sv_src') || localStorage.getItem('pc_src') || localStorage.getItem('el_src') || '{}'); } catch (e) {}

                document.addEventListener('click', function (e) {
                    var msgr = e.target.closest('a[data-messenger]');
                    if (msgr) {
                        window.dataLayer.push({event: 'messenger_click', messenger: msgr.getAttribute('data-messenger'), page_path: location.pathname, site_host: location.host});
                        return;
                    }
                    var tel = e.target.closest('a[href^="tel:"]');
                    if (tel) {
                        window.dataLayer.push({
                            event: 'phone_click',
                            phone: tel.getAttribute('href').replace('tel:', ''),
                            page_path: location.pathname,
                            site_host: location.host,
                            utm_source: src.utm_source || '',
                            utm_medium: src.utm_medium || '',
                            utm_campaign: src.utm_campaign || ''
                        });
                        return;
                    }
                    var open = e.target.closest('[onclick*="lead-modal"]');
                    if (open) {
                        window.dataLayer.push({event: 'lead_form_open', page_path: location.pathname});
                    }
                });
            })();
        </script>
        <script>
            /* Стрічка відгуків. Обрізаємо текст лише тим карткам, які реально
               довші за вісім рядків - інакше кнопка «читати повністю» висіла б
               і над двома реченнями. Стрілки показуємо, тільки якщо є куди
               гортати; на телефоні гортають пальцем. */
            (function () {
                var MORE = {{ 'reviews.more'|trans({}, 'servicesite')|json_encode|raw }};
                var LESS = {{ 'reviews.less'|trans({}, 'servicesite')|json_encode|raw }};

                document.querySelectorAll('.review-card').forEach(function (card) {
                    var text = card.querySelector('.review-text');
                    if (!text) return;
                    text.classList.add('is-clamped');
                    if (text.scrollHeight <= text.clientHeight + 4) {
                        text.classList.remove('is-clamped');
                        return;
                    }
                    var btn = document.createElement('button');
                    btn.type = 'button';
                    btn.className = 'review-more';
                    btn.textContent = MORE;
                    btn.setAttribute('aria-expanded', 'false');
                    btn.addEventListener('click', function () {
                        var open = text.classList.toggle('is-clamped') === false;
                        btn.textContent = open ? LESS : MORE;
                        btn.setAttribute('aria-expanded', open ? 'true' : 'false');
                    });
                    card.appendChild(btn);
                });

                document.querySelectorAll('.reviews-strip').forEach(function (strip) {
                    var row = strip.querySelector('.reviews-row');
                    var prev = strip.querySelector('.reviews-nav.prev');
                    var next = strip.querySelector('.reviews-nav.next');
                    if (!row || !prev || !next) return;

                    function step() {
                        var card = row.querySelector('.review-card');
                        return card ? card.getBoundingClientRect().width + 18 : row.clientWidth * 0.8;
                    }
                    /* обидві стрілки лишаються на місці: кнопка, що зникає,
                       смикає верстку й читається як збій */
                    function sync() {
                        var max = row.scrollWidth - row.clientWidth;
                        prev.classList.toggle('is-edge', row.scrollLeft < 8);
                        next.classList.toggle('is-edge', row.scrollLeft > max - 8);
                    }
                    prev.addEventListener('click', function () { row.scrollBy({left: -step(), behavior: 'smooth'}); });
                    next.addEventListener('click', function () { row.scrollBy({left: step(), behavior: 'smooth'}); });
                    row.addEventListener('scroll', sync, {passive: true});
                    window.addEventListener('resize', sync);
                    sync();
                });
            })();
        </script>
