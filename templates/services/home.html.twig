{% extends 'services/base.html.twig' %}

{% block title %}{{ city.loc('metaTitle', locale) ?? (site.name ~ ' - ' ~ city.name(locale)) }}{% endblock %}

{% block metaDescription %}{{ city.loc('metaDesc', locale) }}{% endblock %}

{% block schema %}
    {% import 'services/partials/_schema.html.twig' as schema %}
    {# бізнес міста + рейтинг і ПОВНИЙ список відгуків (на сторінці карток лише 4) #}
    {% set extra = {} %}
    {% if reviewsAggregate %}
        {% set reviewLd = [] %}
        {% for r in reviewsSchema %}
            {% set entry = {
                '@type': 'Review',
                'author': {'@type': 'Person', 'name': r.loc('author', locale)},
                'reviewBody': r.loc('text', locale),
                'reviewRating': {'@type': 'Rating', 'ratingValue': r.stars, 'bestRating': 5},
            } %}
            {% if r.reviewedAt %}{% set entry = entry|merge({'datePublished': r.reviewedAt|date('Y-m-d')}) %}{% endif %}
            {% set reviewLd = reviewLd|merge([entry]) %}
        {% endfor %}
        {% set extra = {
            'aggregateRating': {
                '@type': 'AggregateRating',
                'ratingValue': reviewsAggregate.avg,
                'reviewCount': reviewsAggregate.count,
                'bestRating': 5,
            },
            'review': reviewsAggregate.includes_site|default(true) ? reviewLd : [],
        } %}
    {% endif %}
    {{ schema.business(site, city, locale, altUrls[locale], app.request.schemeAndHttpHost, extra) }}
    {{ schema.faqPage(homeFaq) }}
    {{ schema.ld({
        '@context': 'https://schema.org',
        '@type': 'WebSite',
        'name': site.name,
        'url': app.request.schemeAndHttpHost ~ '/',
        'inLanguage': sv_locale_code(locale, 'schema'),
    }) }}
{% endblock %}

{% block body %}
    <div class="hero">
        <div class="hero-content">
            <h1>{{ city.loc('introTitle', locale) ?? (site.name ~ ' - ' ~ city.name(locale)) }}</h1>
            {% if city.loc('introText', locale) %}
            <div class="hero-sub">{{ city.loc('introText', locale)|raw }}</div>
            {% endif %}

            <div class="benefits">
                <div class="benefit"><span class="bico">🏅</span><span>{{ 'hero.benefit1'|trans({}, 'servicesite') }}</span></div>
                <div class="benefit"><span class="bico">🛠</span><span>{{ 'hero.benefit2'|trans({}, 'servicesite') }}</span></div>
                <div class="benefit"><span class="bico">📍</span><span>{{ 'hero.benefit3'|trans({}, 'servicesite') }}</span></div>
                <div class="benefit"><span class="bico">🕐</span><span>{{ 'hero.benefit4'|trans({}, 'servicesite') }}</span></div>
                <div class="benefit"><span class="bico">✅</span><span>{{ 'hero.benefit5'|trans({}, 'servicesite') }}</span></div>
            </div>
            <p><button class="btn" onclick="document.getElementById('lead-modal').showModal()">{{ 'lead.cta'|trans({}, 'servicesite') }}</button></p>
        </div>
        {# ілюстрація хіро - з теми паку (hero_image) або шлях із БД (ServiceSite.heroImagePath); srcset/розміри - з теми;
           підпис (ім'я/роль людини на фото) - ключі hero.person_* з перекладів паку, порожні = без підпису #}
        {% set _person = 'hero.person_name'|trans({}, 'servicesite') %}
        {% set _role = 'hero.person_role'|trans({}, 'servicesite') %}
        {% set _hasPerson = _person and _person != 'hero.person_name' %}
        {% set _hero = theme.url('hero_image') ?? site.heroImagePath %}
        {% if _hero %}
        <figure class="hero-img">
            <img src="{{ asset(_hero) }}"
                 {% if theme.get('hero_srcset') %}srcset="{{ theme.get('hero_srcset') }}"{% endif %}
                 alt="{% if _hasPerson %}{{ _person }}{% if _role and _role != 'hero.person_role' %} - {{ _role }}{% endif %}, {% endif %}{{ site.name }}"
                 {% if theme.get('hero_width') %}width="{{ theme.get('hero_width') }}"{% endif %} {% if theme.get('hero_height') %}height="{{ theme.get('hero_height') }}"{% endif %} fetchpriority="high">
            {% if _hasPerson %}
            <figcaption>
                <b>{{ _person }}</b>
                {% if _role and _role != 'hero.person_role' %}<span>{{ _role }}</span>{% endif %}
            </figcaption>
            {% endif %}
            {# лічильники (5120 задоволених клієнтів…) — ключі паку hero.stat1..3_value / _label; порожній value = пункту нема #}
            {% set _stats = [] %}
            {% for i in 1..3 %}
                {% set _v = ('hero.stat' ~ i ~ '_value')|trans({}, 'servicesite') %}
                {% set _l = ('hero.stat' ~ i ~ '_label')|trans({}, 'servicesite') %}
                {% if _v and _v != 'hero.stat' ~ i ~ '_value' %}
                    {% set _stats = _stats|merge([{value: _v, label: (_l != 'hero.stat' ~ i ~ '_label') ? _l : ''}]) %}
                {% endif %}
            {% endfor %}
            {% if _stats is not empty %}
            <ul class="hero-stats">
                {% for st in _stats %}<li><b>{{ st.value }}</b>{% if st.label %}<span>{{ st.label }}</span>{% endif %}</li>{% endfor %}
            </ul>
            {% endif %}
        </figure>
        {% endif %}
    </div>

    {# лід-магніт: та сама форма, але з підзаголовком і месенджерами (lead.subtitle / lead.messengers_hint з паку);
       місце — app.home_lead_position: after_hero (одразу під першим екраном) | after_works (типово, як було). Блок один. #}
    {% set _leadForm %}{% include 'services/partials/_lead_form.html.twig' with {magnet: true, lead_type: 'magnet'} %}{% endset %}
    {% if home_lead_position == 'after_hero' %}{{ _leadForm }}{% endif %}


    <section class="block center">
        <h2>{{ 'home.services_title'|trans({'%city%': city.loc('nameLoc', locale) ?? city.name(locale), '%in%': city_in(city, locale)}, 'servicesite') }}</h2>
        <div class="grid">
            {% for category in categories %}
            <div class="card">
                <h3>{{ category.loc('title', locale) }}</h3>
                <ul>
                    {% for item in itemsByCategory[category.id]|default([]) %}
                    <li><a href="{{ service_path(item, locale) }}">{{ item.loc('title', locale) }}</a></li>
                    {% endfor %}
                </ul>
            </div>
            {% endfor %}
        </div>
    </section>

    {% if city.loc('text2', locale) %}
    <section class="block muted">{{ city.loc('text2', locale)|raw }}</section>
    {% endif %}

    {% if pricesByItem is not empty %}
    <section class="block center" id="prices">
        <h2>{{ 'prices.title'|trans({
            '%in%': city_in(city, locale),
            '%city%': city.loc('nameLoc', locale) ?? city.name(locale),
        }, 'servicesite') }}</h2>
        {# запит на головній загальний («клінінг»), тому прайс показуємо
           повністю, а чіпи лишаємо як швидкі переходи до потрібної послуги #}
        <div class="chips price-jump">
            {% for group in pricesByItem %}
            <a href="#pt-{{ group.item.id }}">{{ group.item.loc('tabTitle', locale) ?? group.item.loc('title', locale) }}</a>
            {% endfor %}
        </div>
        {% for group in pricesByItem %}
        <div class="price-pane" id="pt-{{ group.item.id }}">
            <h3 class="price-pane-title">
                <a href="{{ service_path(group.item, locale) }}">{{ group.item.loc('title', locale) }}</a>
            </h3>
            {# без шапки «Послуга / Ціна»: на сторінці 17 таблиць, і повторений
               заголовок лише засмічує. Назва й сума зрозумілі без підпису #}
            <table class="prices">
                {% for price in group.rows %}
                <tr>
                    <td>
                        {{ price.loc('name', locale) }}
                        {% if price.loc('desc', locale) %}<div class="meta">{{ price.loc('desc', locale) }}</div>{% endif %}
                    </td>
                    <td class="price" style="text-align:right">
                        {% if price.price is not null %}
                            {# ціни цілі, копійок у прайсі не буває #}
                            {% if price.pricePrefix %}{{ ('prices.from'|trans({}, 'servicesite'))|capitalize }} {% endif %}{{ price.price|number_format(0, '.', ' ') }} {{ 'catalog.uah'|trans({}, 'servicesite') }}
                        {% else %}
                            {{ price.loc('priceText', locale) ?? 'catalog.price_free_text'|trans({}, 'servicesite') }}
                        {% endif %}
                    </td>
                </tr>
                {% endfor %}
            </table>
        </div>
        {% endfor %}
        <p class="prices-calc-link">
            <a class="btn" href="{{ path('sv_calculator') }}">{{ 'calc.mini_full'|trans({}, 'servicesite') }} →</a>
        </p>
    </section>
    {% endif %}

    {# розгорнутий СЕО-текст під цінами (правиться в адмінці: Міста сервісів → Блок 3) #}
    {# Міні-калькулятора тут немає навмисно: на головній уже стоїть повний
       прайс, і другий спосіб дізнатись ціну лише роздвоює увагу. Кому
       потрібен розрахунок під свою квартиру - переходить на калькулятор. #}
    {# власні кадри з об'єктів: на головній вони йдуть загальним рядом,
       бо запит тут широкий - «клінінг», а не конкретна послуга #}
    {% include 'services/partials/_works.html.twig' with {works: works|default([])} %}

    {% if home_lead_position != 'after_hero' %}{{ _leadForm }}{% endif %}

    {% if city.loc('text3', locale) %}
    <section class="block muted seo-text">{{ city.loc('text3', locale)|raw }}</section>
    {% endif %}

    {% if reviews is not empty %}
    <section class="block muted center">
        <h2>{{ 'home.reviews_title'|trans({}, 'servicesite') }}</h2>
        {% if reviewsAggregate %}
        {% include 'services/partials/_rating_line.html.twig' with {agg: reviewsAggregate, all_url: path('sv_reviews')} only %}
        {% endif %}
        {% include 'services/partials/_reviews_row.html.twig' %}
    </section>
    {% endif %}

    {# команда: після відгуків, якщо пак додав home у app.team_pages (10.2026); типово лише на «Про нас» #}
    {% include 'services/partials/_team.html.twig' %}

    {% if homeDistricts is not empty %}
    <section class="block center">
        <h2>{{ 'home.districts_title'|trans({'%cityGen%': city.loc('nameGen', locale) ?? city.name(locale)}, 'servicesite') }}</h2>
        {% if city.loc('districtsIntro', locale) %}<div>{{ city.loc('districtsIntro', locale)|raw }}</div>{% endif %}
        {# типово лише офіційні райони (118 посилань з головної розмивали вагу); пак може задати свій список — app.home_districts #}
        <div class="chips chips-center">
            {% for d in homeDistricts %}
            {# у назві злиті масив і район («Голосіїв і Голосіївський район») - на
               головній лишаємо коротку частину, інакше на телефоні кожен чип займає рядок #}
            <a href="{{ path('sv_district', {slug: d.slug(locale)}) }}">{{ d.loc('name', locale)|split(locale == 'ru' ? ' и ' : ' і ')|first|replace({' район': ''}) }}</a>
            {% endfor %}
            {# посилання на повний список - тим самим рядком, а не окремою кнопкою #}
            <a class="more" href="{{ path('sv_districts') }}">{{ 'district.all_link'|trans({}, 'servicesite') }}</a>
        </div>
    </section>
    {% endif %}

    {# на головній — перші app.home_faq_limit питань (0 = усі); повний список на /faq/ #}
    {% include 'services/partials/_faq.html.twig' with {faq: homeFaq, centerTitle: true, muted: true} %}
    {% if homeFaq is not empty and faqTotal|default(0) > homeFaq|length %}
    <p class="center"><a class="more faq-all" href="{{ path('sv_faq') }}">{{ 'home.faq_all'|trans({}, 'servicesite') }}</a></p>
    {% endif %}

{% endblock %}
