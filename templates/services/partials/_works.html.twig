{# Власні фото з обʼєктів. Кадри свої, не стоки - тому підпис під знімком
   конкретний («Хімчистка офісного крісла»), а не «якісне прибирання».

   Пара «до/після» показується лише там, де вона справжня: у наших зйомках
   пар майже немає, і підставляти під «до» чужий кадр - обман, який видно.
   Тому за замовчуванням це просто сітка знімків. #}
{% if works|default([]) is not empty %}
<section class="block works">
    {# саме h2, а не block-title: це розділ сторінки з власним заголовком,
       а не службовий підпис на кшталт «Інші послуги категорії» #}
    <h2>{{ title|default('works.title'|trans({}, 'servicesite')) }}</h2>
    <div class="works-grid">
        {% for work in works %}
        <figure class="work-card">
            {% if work.hasPair %}
            <div class="work-pair">
                <span class="work-shot">
                    <img src="/media/service_work/{{ work.beforeName }}"
                         alt="{{ work.beforeAlt ?? work.loc('title', locale) }}"
                         width="1200" height="675" loading="lazy" decoding="async">
                    <b>{{ 'works.before'|trans({}, 'servicesite') }}</b>
                </span>
                <span class="work-shot">
                    <img src="/media/service_work/{{ work.imageName }}"
                         alt="{{ work.imageAlt ?? work.loc('title', locale) }}"
                         width="1200" height="675" loading="lazy" decoding="async">
                    <b>{{ 'works.after'|trans({}, 'servicesite') }}</b>
                </span>
            </div>
            {% elseif work.imageName %}
            <img src="/media/service_work/{{ work.imageName }}"
                 alt="{{ work.imageAlt ?? work.loc('title', locale) }}"
                 width="1200" height="675" loading="lazy" decoding="async">
            {% endif %}
            <figcaption>
                {{ work.loc('title', locale) }}
                {% if work.loc('caption', locale) %}<span class="meta">{{ work.loc('caption', locale) }}</span>{% endif %}
            </figcaption>
        </figure>
        {% endfor %}
    </div>
</section>
{% endif %}
