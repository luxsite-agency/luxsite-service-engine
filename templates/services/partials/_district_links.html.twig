{# Блок посилань на локації. Використовується на сторінці району (сусіди),
   на сторінці послуги (ротований зріз) і на головній (офіційні райони).
   Параметри: districts, title (ключ перекладу), lead (необовʼязковий текст). -#}
{% if districts is not empty %}
<section class="block">
    <h2>{{ title }}</h2>
    {% if lead is defined and lead %}<p class="meta">{{ lead }}</p>{% endif %}
    <div class="chips">
        {% for d in districts %}
        <a href="{{ path('sv_district', {slug: d.slug(locale)}) }}">{{ d.loc('name', locale) }}</a>
        {% endfor %}
    </div>
</section>
{% endif %}
