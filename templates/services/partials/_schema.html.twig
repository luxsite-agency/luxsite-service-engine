{# Макроси мікророзмітки (JSON-LD). Підключення:
   {% import 'services/partials/_schema.html.twig' as schema %}
   {{ schema.ld({...}) }} / {{ schema.crumbs([...]) }} / {{ schema.faqPage(faq) }} #}

{% macro ld(data) %}
<script type="application/ld+json">{{ data|json_encode(constant('JSON_UNESCAPED_UNICODE') b-or constant('JSON_UNESCAPED_SLASHES'))|raw }}</script>
{% endmacro %}

{# items: [{name, url}] - останній елемент без url (поточна сторінка) #}
{% macro crumbs(items) %}
    {% import _self as self %}
    {% set list = [] %}
    {% for it in items %}
        {% set entry = {'@type': 'ListItem', 'position': loop.index, 'name': it.name} %}
        {% if it.url is defined and it.url %}{% set entry = entry|merge({'item': it.url}) %}{% endif %}
        {% set list = list|merge([entry]) %}
    {% endfor %}
    {{ self.ld({'@context': 'https://schema.org', '@type': 'BreadcrumbList', 'itemListElement': list}) }}
{% endmacro %}

{# faq: [{q, a}] з БД #}
{% macro faqPage(faq) %}
    {% import _self as self %}
    {% if faq is not empty %}
        {% set qs = [] %}
        {% for f in faq %}
            {% if f.q is defined and f.a is defined and f.q and f.a %}
                {% set qs = qs|merge([{
                    '@type': 'Question',
                    'name': f.q|striptags,
                    'acceptedAnswer': {'@type': 'Answer', 'text': f.a|striptags},
                }]) %}
            {% endif %}
        {% endfor %}
        {% if qs is not empty %}
            {{ self.ld({'@context': 'https://schema.org', '@type': 'FAQPage', 'mainEntity': qs}) }}
        {% endif %}
    {% endif %}
{% endmacro %}

{# Бізнес-сутність міста: спільна для головної, контактів, відгуків, районів.
   host - app.request.schemeAndHttpHost (для абсолютних шляхів зображень) #}
{# legalName/founder/openingHours - з паку (app.schema), бо це юридична особа конкретного бренду;
   те саме, що на «Про нас» (about.legal). Порожнє значення - поля в розмітці нема #}
{% macro business(site, city, locale, url, host, extra) %}
    {% import _self as self %}
    {% set data = {
        '@context': 'https://schema.org',
        '@type': site.schemaType,
        '@id': host ~ '/#business',
        'name': site.name ~ ' - ' ~ city.name(locale),
        'url': url,
        'address': {'@type': 'PostalAddress', 'addressLocality': city.name(locale), 'addressCountry': 'UA'},
        'areaServed': {'@type': 'City', 'name': city.name(locale)},
        'priceRange': '$$',
    } %}
    {% if schema_business.legal_name %}{% set data = data|merge({'legalName': schema_business.legal_name}) %}{% endif %}
    {% if schema_business.founder %}{% set data = data|merge({'founder': {'@type': 'Person', 'name': schema_business.founder}}) %}{% endif %}
    {% if city.phone %}{% set data = data|merge({'telephone': city.phone}) %}{% endif %}
    {% if city.email %}{% set data = data|merge({'email': city.email}) %}{% endif %}
    {# адрес може бути кілька, по рядку; у розмітку йде лише перший (адреса цього міста).
       Вулиця - до другої коми: «вулиця Прикладна, 4» #}
    {% if city.address(locale) %}
        {% set parts = (city.address(locale)|split("\n")|first)|split(', ') %}
        {% set data = data|merge({'address': data.address|merge({'streetAddress': parts|slice(0, 2)|join(', ')})}) %}
    {% endif %}
    {# зображення - og-картинка теми паку (або хіро бренду), лого - з теми #}
    {% set _img = theme.url('og_image') ?? theme.url('hero_image') ?? site.heroImagePath %}
    {% if _img %}{% set data = data|merge({'image': host ~ _img}) %}{% endif %}
    {% if theme.url('logo') %}{% set data = data|merge({'logo': host ~ theme.url('logo')}) %}{% endif %}
    {# графік у машинному форматі (app.schema.opening_hours); людський варіант — у city.hours #}
    {% if city.hours and schema_business.opening_hours %}{% set data = data|merge({'openingHours': schema_business.opening_hours}) %}{% endif %}
    {{ self.ld(data|merge(extra|default({}))) }}
{% endmacro %}
