{# Акордеон «Де ми працюємо»: групи-адмінрайони → мікрорайони-посилання.
   Очікує districtGroups (з findActiveByCityGrouped) і locale;
   allOpen: true — всі групи розгорнуті одразу (сторінка /districts/);
   linkPrimary: true — якщо в групі є primary-район (group.primary), його назва в заголовку стає посиланням на його
   сторінку, а сам він не дублюється чипом (схема app.district_suburb_groups). -#}
<div class="district-groups">
    {% for group in districtGroups %}
    {% set label = (group.districts|first).loc('group', locale) %}
    {% set primaryOf = linkPrimary|default(false) ? group.primary|default(null) : null %}
    <details class="dgroup"{% if allOpen|default(false) %} open{% endif %}>
        <summary class="acc-chevron">{% if primaryOf %}<a href="{{ path('sv_district', {slug: primaryOf.slug(locale)}) }}">{{ label ?? primaryOf.loc('name', locale) }}</a>{% else %}{{ label ?? 'districts.other'|trans({}, 'servicesite') }}{% endif %}</summary>
        <div class="chips">
            {% for district in group.districts %}
            {% if not primaryOf or district.id != primaryOf.id %}
            <a href="{{ path('sv_district', {slug: district.slug(locale)}) }}">{{ district.loc('name', locale) }}</a>
            {% endif %}
            {% endfor %}
        </div>
    </details>
    {% endfor %}
</div>
