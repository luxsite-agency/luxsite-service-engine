{# Акордеон FAQ: faq = list of {q, a}. JSON-LD FAQPage — на етапі SEO (S7). #}
{% if faq is not empty %}
<section class="block{% if muted|default(false) %} muted{% endif %}{% if centerTitle|default(false) %} center{% endif %}">
    {% if faqTitle is not defined or faqTitle is not same as(false) %}
    <h2>{{ faqTitle|default('home.faq_title'|trans({}, 'servicesite')) }}</h2>
    {% endif %}
    {% for entry in faq %}
    <details class="faq">
        <summary class="acc-chevron">{{ entry.q }}</summary>
        <div>{{ entry.a|nl2br }}</div>
    </details>
    {% endfor %}
</section>
{% endif %}
