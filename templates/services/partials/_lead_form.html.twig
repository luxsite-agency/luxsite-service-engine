{# Інлайн-форма заявки: телефон обов'язковий, ім'я/повідомлення опційні.
   Honeypot-поле website приховане; CSRF-токен sv_lead.
   Параметри include: magnet (bool, головна — лід-магніт: абзац lead.subtitle під заголовком і месенджери міста з підписом
   lead.messengers_hint під формою; порожні ключі = елементів нема), lead_type ('form' | 'magnet' → на /thank-you/ lead_type
   у dataLayer, щоб у GA4 було видно, звідки заявка).
   Перед кнопкою — додаткові поля паку (app.lead_fields) і згода на обробку ПД (app.lead_consent); без них розмітка як була. #}
{% set magnet = magnet|default(false) %}
{% set lead_type = lead_type|default('form') %}
<section class="block lead-form{% if magnet %} lead-magnet{% endif %}" id="lead">
    {# не h2: заголовок форми не входить у смислову структуру сторінки (SEO) #}
    <p class="form-title">{{ 'lead.title'|trans({}, 'servicesite') }}</p>
    {% if magnet %}{% set _sub = 'lead.subtitle'|trans({}, 'servicesite') %}{% if _sub and _sub != 'lead.subtitle' %}<p class="form-sub">{{ _sub }}</p>{% endif %}{% endif %}
    {% for msg in app.flashes('lead_success') %}
    <p style="color:#0a7a2f;font-weight:600">{{ msg }}</p>
    {% endfor %}
    {% for msg in app.flashes('lead_error') %}
    <p style="color:#b00020;font-weight:600">{{ msg }}</p>
    {% endfor %}
    <form method="post" action="{{ path('sv_lead') }}" data-lead-form data-lead-type="{{ lead_type }}" style="display:flex;gap:.6rem;flex-wrap:wrap;align-items:flex-start">
        <input type="hidden" name="_token" value="{{ csrf_token('sv_lead') }}">
        <input type="hidden" name="lead_type" value="{{ lead_type }}">
        <input type="text" name="website" value="" tabindex="-1" autocomplete="off" style="position:absolute;left:-9999px" aria-hidden="true">
        <input type="tel" name="phone" required placeholder="{{ 'lead.phone'|trans({}, 'servicesite') }}" style="padding:.55rem;border:1px solid #ccc;border-radius:6px;min-width:200px" aria-label="{{ 'lead.phone'|trans({}, 'servicesite') }}">
        <input type="text" name="name" placeholder="{{ 'lead.name'|trans({}, 'servicesite') }}" style="padding:.55rem;border:1px solid #ccc;border-radius:6px;min-width:180px" aria-label="{{ 'lead.name'|trans({}, 'servicesite') }}">
        <input type="text" name="message" placeholder="{{ 'lead.message'|trans({}, 'servicesite') }}" style="padding:.55rem;border:1px solid #ccc;border-radius:6px;flex:1;min-width:220px" aria-label="{{ 'lead.message'|trans({}, 'servicesite') }}">
        {{- include('services/partials/_lead_fields.html.twig') }}
        <button class="btn" type="submit">{{ 'lead.submit'|trans({}, 'servicesite') }}</button>
    </form>
    {% if magnet and city.hasMessengers %}{% set _hint = 'lead.messengers_hint'|trans({}, 'servicesite') %}
    <p class="lead-msgrs">{% if _hint and _hint != 'lead.messengers_hint' %}<span>{{ _hint }}</span>{% endif %}{% include 'services/partials/_messengers.html.twig' %}</p>
    {% endif %}
</section>
