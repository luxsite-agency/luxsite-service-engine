{# Блок «Наша команда» (ServiceTeamMember міста). Де показувати — пак: app.team_pages ([about] типово; about|contacts).
   Очікує team (масив) і locale; порожня команда = блоку нема. team_title — свій заголовок (блок «Фахівці» на послузі).
   Картка — services/team/_card.html.twig (зі сторінками команди веде на сторінку людини). -#}
{% if team is defined and team is not empty %}
<section class="block muted">
    <h2>{{ team_title|default('home.team_title'|trans({}, 'servicesite')) }}</h2>
    <div class="grid">
        {% for member in team %}
        {% include 'services/team/_card.html.twig' %}
        {% endfor %}
    </div>
</section>
{% endif %}
