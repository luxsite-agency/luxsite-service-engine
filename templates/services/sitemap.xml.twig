<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9"
        xmlns:xhtml="http://www.w3.org/1999/xhtml">
{#- e['urls']: мова бренду → URL; xhtml:link лише коли мов більше однієї, x-default — мова без префікса #}
{%- for e in entries %}
{%- set urls = e['urls']|filter((u, l) => l != 'ru' or ru_mode == 'full') %}
{%- for locale, loc in urls %}
    <url>
        <loc>{{ loc }}</loc>
{%- if e.lastmod %}
        <lastmod>{{ e.lastmod|date('Y-m-d') }}</lastmod>
{%- endif %}
{%- if urls|length > 1 %}
{% for l, u in urls %}        <xhtml:link rel="alternate" hreflang="{{ sv_locale_code(l, 'hreflang') }}" href="{{ u }}"/>
{% endfor %}        <xhtml:link rel="alternate" hreflang="x-default" href="{{ urls|first }}"/>
{% endif %}    </url>
{%- endfor %}
{%- endfor %}
</urlset>
