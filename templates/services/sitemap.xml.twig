<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9"
        xmlns:xhtml="http://www.w3.org/1999/xhtml">
{#- e.urls: мова бренду → URL; xhtml:link — ті самі коди й правила, що в <head> (sv_hreflangs: від двох мов або app.hreflang_single) #}
{%- for e in entries %}
{%- for locale, loc in e.urls %}
    <url>
        <loc>{{ loc }}</loc>
{%- if e.lastmod %}
        <lastmod>{{ e.lastmod|date('Y-m-d') }}</lastmod>
{%- endif %}
{%- for h in sv_hreflangs(e.urls) %}
        <xhtml:link rel="alternate" hreflang="{{ h['hreflang'] }}" href="{{ h['href'] }}"/>
{%- endfor %}
    </url>
{%- endfor %}
{%- endfor %}
</urlset>
