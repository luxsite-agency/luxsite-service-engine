{% extends 'services/base.html.twig' %}

{% block title %}{{ 'title.catalog'|trans({'%city%': city.loc('nameLoc', locale) ?? city.name(locale), '%in%': city_in(city, locale), '%cityNom%': city.name(locale)}, 'servicesite') }}{% endblock %}

{% block metaDescription %}{{ 'meta.catalog'|trans({'%city%': city.loc('nameLoc', locale) ?? city.name(locale), '%in%': city_in(city, locale), '%cityNom%': city.name(locale)}, 'servicesite') }}{% endblock %}

{% block schema %}
    {% import 'services/partials/_schema.html.twig' as schema %}
    {{ schema.crumbs([
        {'name': 'common.breadcrumb_home'|trans({}, 'servicesite'), 'url': url('sv_home', {_locale: locale})},
        {'name': 'catalog.title'|trans({}, 'servicesite')},
    ]) }}
{% endblock %}

{% block body %}
    <nav class="breadcrumbs">
        <a href="{{ path('sv_home') }}">{{ 'common.breadcrumb_home'|trans({}, 'servicesite') }}</a> →
        {{ 'catalog.title'|trans({}, 'servicesite') }}
    </nav>
    <h1>{{ 'catalog.title'|trans({}, 'servicesite') }}</h1>
    <div class="grid">
        {% for category in categories %}
        <div class="card">
            {#- сторінка категорії є лише в схемі nested; у flat картинка без посилання #}
            {% if category.imageName %}
            {% if catalog_url_scheme == 'nested' and category.landing %}<a href="{{ path('sv_category', {category: category.slug(locale)}) }}">{% endif %}
                <img src="/media/service_category/{{ category.imageName }}" alt="{{ category.imageAlt ?? category.loc('title', locale) }}"
                     style="width:100%;aspect-ratio:1536/1024;object-fit:cover;border-radius:8px;margin-bottom:.7rem;display:block">
            {% if catalog_url_scheme == 'nested' and category.landing %}</a>{% endif %}
            {% endif %}
            <h2>{% if catalog_url_scheme == 'nested' and category.landing %}<a href="{{ path('sv_category', {category: category.slug(locale)}) }}">{{ category.loc('title', locale) }}</a>{% else %}{{ category.loc('title', locale) }}{% endif %}</h2>
            <ul>
                {% for item in itemsByCategory[category.id]|default([]) %}
                <li><a href="{{ service_path(item, locale) }}">{{ item.loc('title', locale) }}</a></li>
                {% endfor %}
            </ul>
        </div>
        {% endfor %}
    </div>
{% endblock %}
