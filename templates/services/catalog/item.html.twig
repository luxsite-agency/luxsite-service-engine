{% extends 'services/base.html.twig' %}

{# міський текст (override = ServiceItemCity) має пріоритет у кожному полі; порожні падають на послугу: ov(override, item, …) #}
{% block title %}{{ ov(override|default(null), item, 'metaTitle', locale)
    ?? (ov(override|default(null), item, 'title', locale) ~ ' ' ~ city_in(city, locale) ~ ' '
        ~ (city.loc('nameLoc', locale) ?? city.name(locale)) ~ ' - ' ~ site.name) }}{% endblock %}

{% block metaDescription %}{{ ov(override|default(null), item, 'metaDesc', locale) ?? ov(override|default(null), item, 'lead', locale) }}{% endblock %}
{% block ogImage %}{{ item.imageName ? '/media/service_item/' ~ item.imageName : (theme.url('og_image') ?? theme.url('hero_image') ?? site.heroImagePath ?? '') }}{% endblock %}

{% block schema %}
    {% import 'services/partials/_schema.html.twig' as schema %}
    {{ schema.crumbs([
        {'name': 'common.breadcrumb_home'|trans({}, 'servicesite'), 'url': url('sv_home', {_locale: locale})},
    ]|merge(catalog_url_scheme != 'root' ? [{'name': 'catalog.title'|trans({}, 'servicesite'), 'url': url('sv_services', {_locale: locale})}] : [])|merge(catalog_url_scheme in ['nested', 'root'] and category.landing
        ? [{'name': category.loc('title', locale), 'url': url('sv_category', {category: category.slug(locale), _locale: locale})}]
        : [])|merge([
        {'name': ov(override|default(null), item, 'title', locale)},
    ])) }}
    {% set offers = [] %}
    {% for price in prices|filter(p => p.price) %}
        {% set offer = {
            '@type': 'Offer',
            'name': price.loc('name', locale),
            'price': price.price|number_format(0, '.', ''),
            'priceCurrency': 'UAH',
            'availability': 'https://schema.org/InStock',
            'url': altUrls[locale],
        } %}
        {# ціна за одиницю без одиниці читається як ціна за роботу цілком:
           «160 грн» замість «160 грн за м²» #}
        {% if price.perUnit and price.loc('unit', locale) %}
            {% set offer = offer|merge({'priceSpecification': {
                '@type': 'UnitPriceSpecification',
                'price': price.price|number_format(0, '.', ''),
                'priceCurrency': 'UAH',
                'unitText': price.loc('unit', locale),
            }}) %}
        {% endif %}
        {% if price.loc('desc', locale) %}
            {% set offer = offer|merge({'description': price.loc('desc', locale)|striptags}) %}
        {% endif %}
        {% set offers = offers|merge([offer]) %}
    {% endfor %}
    {# рахуємо числами: sort по рядках ставив «1000.00» попереду «99.00» #}
    {% set amounts = prices|filter(p => p.price)|map(p => p.price + 0)|sort %}
    {# Тип залежить від того, чи є прайс. Є ціни - Product: тільки цьому типу
       Google показує зірочки й діапазон цін, для LocalBusiness і Organization
       відгуки з власного сайту вважаються self-serving і не рендеряться.
       Немає цін - лишається Service, бо Product без offers беззмістовний. #}
    {% set isProduct = offers is not empty %}
    {% set svc = {
        '@context': 'https://schema.org',
        '@type': isProduct ? 'Product' : 'Service',
        'name': ov(override|default(null), item, 'title', locale) ~ ' ' ~ city_in(city, locale) ~ ' ' ~ (city.loc('nameLoc', locale) ?? city.name(locale)),
        'url': altUrls[locale],
    } %}
    {% if isProduct %}
        {% set svc = svc|merge({
            'brand': {'@type': 'Brand', 'name': site.name},
            'category': ov(override|default(null), item, 'title', locale),
        }) %}
        {# рейтинг рахується з наших же відгуків: число має збігатися з тим,
           що людина побачить на /reviews/, інакше це вигадка #}
        {% if reviewsAggregate|default(null) %}
            {% set svc = svc|merge({'aggregateRating': {
                '@type': 'AggregateRating',
                'ratingValue': reviewsAggregate.avg,
                'reviewCount': reviewsAggregate.count,
                'bestRating': 5,
                'worstRating': 1,
            }}) %}
        {% endif %}
    {% else %}
        {% set svc = svc|merge({
            'serviceType': ov(override|default(null), item, 'title', locale),
            'areaServed': {'@type': 'City', 'name': city.name(locale)},
            'provider': {
                '@type': site.schemaType,
                '@id': app.request.schemeAndHttpHost ~ '/#business',
                'name': site.name ~ ' - ' ~ city.name(locale),
                'telephone': city.phone,
                'url': app.request.schemeAndHttpHost ~ '/',
            },
        }) %}
    {% endif %}
    {% set _ldLead = ov(override|default(null), item, 'lead', locale) %}
    {% if _ldLead %}{% set svc = svc|merge({'description': _ldLead|striptags}) %}{% endif %}
    {% if item.imageName %}{% set svc = svc|merge({'image': app.request.schemeAndHttpHost ~ '/media/service_item/' ~ item.imageName}) %}{% endif %}
    {% if offers is not empty %}
        {% set svc = svc|merge({'offers': {
            '@type': 'AggregateOffer',
            'priceCurrency': 'UAH',
            'offerCount': offers|length,
            'lowPrice': amounts|first|number_format(0, '.', ''),
            'highPrice': amounts|last|number_format(0, '.', ''),
            'offers': offers,
        }}) %}
    {% endif %}
    {{ schema.ld(svc) }}
    {{ schema.faqPage((override is defined and override and override.loc('faq', locale)) ? override.loc('faq', locale) : (item.loc('faq', locale) ?? [])) }}
{% endblock %}

{# міський текст має пріоритет; порожні поля падають на загальні #}
{% set txt = override|default(null) %}

{% block body %}
    <nav class="breadcrumbs">
        <a href="{{ path('sv_home') }}">{{ 'common.breadcrumb_home'|trans({}, 'servicesite') }}</a> →
        {# root (категорії від кореня): загального каталогу в крихтах нема — одразу категорія #}
        {% if catalog_url_scheme != 'root' %}<a href="{{ path('sv_services') }}">{{ 'catalog.title'|trans({}, 'servicesite') }}</a> →{% endif %}
        {# у nested/root у категорії є сторінка — крихта активна; у flat сторінки нема #}
        {% if catalog_url_scheme in ['nested', 'root'] and category.landing %}<a href="{{ path('sv_category', {category: category.slug(locale)}) }}">{{ category.loc('title', locale) }}</a>{% else %}<span>{{ category.loc('title', locale) }}</span>{% endif %} →
        {{ ov(txt, item, 'title', locale) }}
    </nav>
    <div class="hero">
        <div class="hero-content">
            <h1>{{ ov(txt, item, 'title', locale) }}</h1>
            {% set _lead = (txt and txt.loc('lead', locale)) ? txt.loc('lead', locale) : item.loc('lead', locale) %}
            {% if _lead %}
            <p class="hero-sub">{{ _lead|striptags }}</p>
            {% endif %}
            <p class="hero-actions">
                <button class="btn" onclick="document.getElementById('lead-modal').showModal()">{{ 'lead.cta'|trans({}, 'servicesite') }}</button>
                {% if city.phone %}
                <a class="btn btn-ghost" href="tel:{{ city.phone|replace({' ': '', '(': '', ')': '', '-': ''}) }}">{{ 'common.call'|trans({}, 'servicesite') }}: {{ city.phone }}</a>
                {% endif %}
            </p>
        </div>
        {% if item.imageName %}
        <div class="hero-img">
            {# LCP-кандидат: webp через Liip (item_hero 920 / item_hero_sm 460), не оригінал; перший запит іде через
               /media/cache/resolve і редірект, далі статика з кешу (shared/media) і CF #}
            {% set _src = asset('media/service_item/' ~ item.imageName) %}
            <img src="{{ _src|imagine_filter('item_hero_sm') }}" srcset="{{ _src|imagine_filter('item_hero_sm') }} 460w, {{ _src|imagine_filter('item_hero') }} 920w"
                 sizes="(max-width: 759px) 100vw, 420px" alt="{{ item.imageAlt ?? ov(txt, item, 'title', locale) }}"
                 width="920" height="613" fetchpriority="high">
        </div>
        {% endif %}
    </div>

    {# додаткові поля запису з паку (app.custom_fields; тип авто: вантажопідйомність, габарити, об'єм…); нема = блоку нема #}
    {% set _specs = custom_fields(item, locale) %}
    {% if _specs is not empty %}
    <section class="block">
        <h2>{{ 'catalog.specs_title'|trans({}, 'servicesite') }}</h2>
        <table class="specs">
            {% for spec in _specs %}
            <tr><th scope="row">{{ spec.label }}</th><td>{{ spec.value }}</td></tr>
            {% endfor %}
        </table>
        {%- set _pricesNote = 'prices.note'|trans({}, 'servicesite') %}
        {%- if _pricesNote %}
        <p class="meta prices-note">{{ _pricesNote }}</p>
        {%- endif %}
    </section>
    {% endif %}

    {% set _desc = (txt and txt.loc('desc', locale)) ? txt.loc('desc', locale) : item.loc('desc', locale) %}
    {% if _desc %}<section class="block">{{ _desc|raw }}</section>{% endif %}

    {% if prices is not empty %}
    <section class="block">
        {# «Скільки коштує хімчистка килимів у Києві» - так це питання ставлять
           у пошуку. Назва послуги йде з малої літери, бо стоїть усередині речення. #}
        {% set _svcName = ov(txt, item, 'title', locale) %}
        {% set _svcName = _svcName|slice(0, 1)|lower ~ _svcName|slice(1) %}
        <h2>{{ 'catalog.prices_title_full'|trans({
            '%service%': _svcName,
            '%in%': city_in(city, locale),
            '%city%': city.loc('nameLoc', locale) ?? city.name(locale),
        }, 'servicesite') }}</h2>
        <table class="prices">
            {% for price in prices %}
            <tr>
                <td>
                    {{ price.loc('name', locale) }}
                    {% if price.loc('desc', locale) %}<div class="meta">{{ price.loc('desc', locale) }}</div>{% endif %}
                </td>
                <td class="price">
                    {% if price.price is not null %}
                        {% if price.pricePrefix %}{{ 'prices.from'|trans({}, 'servicesite') }} {% endif %}{{ price.price|number_format(0, '.', ' ') }} {{ 'catalog.uah'|trans({}, 'servicesite') }}
                    {% else %}
                        {{ price.loc('priceText', locale) ?? 'catalog.price_free_text'|trans({}, 'servicesite') }}
                    {% endif %}
                </td>
            </tr>
            {% endfor %}
        </table>
    </section>
    {% endif %}

    {% set _desc2 = ov(txt, item, 'desc2', locale) %}{% if _desc2 %}<section class="block">{{ _desc2|raw }}</section>{% endif %}
    {% set _desc3 = ov(txt, item, 'desc3', locale) %}{% if _desc3 %}<section class="block">{{ _desc3|raw }}</section>{% endif %}

    {# власні фото стоять після тексту й перед калькулятором: людина вже
       прочитала, що робимо, і бачить це на реальних кадрах, перш ніж рахувати #}
    {# заголовок галереї - окремий ключ під кожну послугу: «Як ми
       прибираємо квартиру» замість склеєного «<послуга>: як це виглядає
       в нас». Немає ключа - лишається нейтральне «Наші роботи». #}
    {% set _wKey = 'works.h2.' ~ item.slug('uk') %}
    {% set _wTitle = _wKey|trans({}, 'servicesite') %}
    {% include 'services/partials/_works.html.twig' with {
        works: works|default([]),
        title: _wTitle != _wKey ? _wTitle : 'works.title'|trans({}, 'servicesite'),
    } %}

    {% if calcTypes|default([]) %}
        {% include 'services/partials/_calc_mini.html.twig' with {
            calcActive: item.calcType.id,
            calcSlug: item.slug(locale),
            calcTitle: 'calc.mini_title_service',
        } %}
    {% endif %}

    {% if districtLinks|default([]) %}
    {% include 'services/partials/_district_links.html.twig' with {
        districts: districtLinks,
        title: 'district.service_title'|trans({'%cityGen%': city.loc('nameGen', locale) ?? city.name(locale)}, 'servicesite'),
    } %}
    {% endif %}

    {% include 'services/partials/_faq.html.twig' with {faq: (txt and txt.loc('faq', locale)) ? txt.loc('faq', locale) : (item.loc('faq', locale) ?? [])} %}

    {% include 'services/partials/_lead_form.html.twig' %}

    {% if related is not empty %}
    <section class="block">
        <p class="block-title">{{ 'catalog.related_title'|trans({}, 'servicesite') }}</p>
        <div class="chips">
            {% for rel in related %}
            <a href="{{ service_path(rel, locale) }}">{{ rel.loc('title', locale) }}</a>
            {% endfor %}
        </div>
    </section>
    {% endif %}
{% endblock %}
