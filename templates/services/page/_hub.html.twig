{# Хаб (сторінка app.pages з шаблоном hub): картки обраних послуг з різних категорій у стилі сторінки категорії.
   hubItems — з ServicePageController: порядок каталогу, лише активні й видимі в місті. Пак перекриває цей файл. -#}
{% if hubItems is not empty %}
<section class="block page-hub">
    <div class="grid">
        {% for item in hubItems %}
        <div class="card">
            <h2 class="card-name"><a href="{{ service_path(item, locale) }}">{{ item.shortName(locale) }}</a></h2>
            {% set _ilead = item_text(item, 'lead', locale) %}{% if _ilead %}<p>{{ _ilead|striptags|slice(0, 160) }}…</p>{% endif %}
        </div>
        {% endfor %}
    </div>
</section>
{% endif %}
