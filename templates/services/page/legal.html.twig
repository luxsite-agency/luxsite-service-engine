{% extends 'services/base.html.twig' %}

{% block title %}{{ heading|trans({}, 'servicesite') }} - {{ site.name }}{% endblock %}

{% block metaDescription %}{{ ('meta.' ~ heading|split('.')|last)|trans({}, 'servicesite') }}{% endblock %}

{% block body %}
    <nav class="breadcrumbs">
        <a href="{{ path('sv_home') }}">{{ 'common.breadcrumb_home'|trans({}, 'servicesite') }}</a> →
        {{ heading|trans({}, 'servicesite') }}
    </nav>
    <h1>{{ heading|trans({}, 'servicesite') }}</h1>
    <div class="legal-text">{{ text|raw }}</div>
{% endblock %}
