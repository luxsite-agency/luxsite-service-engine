# php-fpm для стенда в Docker за traefik (docker-compose.traefik.yml). Відмінності від docker/php/Dockerfile (локалка):
# без xdebug; працює від UID/GID користувача стенда (build-аргументи, їх передає compose зі SITE_UID/SITE_GID),
# щоб у спільній теці стенда не плодити root-файлів; opcache перечитує диск (код міняє deploy, але стенд інколи правлять руками).
FROM php:8.4-fpm

RUN apt-get update && apt-get install -y --no-install-recommends \
        git unzip libicu-dev libzip-dev libpng-dev libjpeg-dev libwebp-dev libfreetype-dev \
        default-mysql-client \
    && docker-php-ext-configure gd --with-jpeg --with-webp --with-freetype \
    && docker-php-ext-install -j"$(nproc)" intl pdo_mysql zip opcache gd \
    && pecl install redis \
    && docker-php-ext-enable redis \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

COPY --from=composer:2 /usr/bin/composer /usr/bin/composer

COPY traefik.ini /usr/local/etc/php/conf.d/zz-traefik.ini

ARG UID=1000
ARG GID=1000
# група може вже існувати в базовому образі з таким gid — тоді лише користувач
RUN (getent group "${GID}" >/dev/null || groupadd -g "${GID}" app) \
    && useradd -m -u "${UID}" -g "${GID}" app \
    && sed -i -e 's/^user = .*/user = app/' -e "s/^group = .*/group = $(getent group "${GID}" | cut -d: -f1)/" /usr/local/etc/php-fpm.d/www.conf
# томи vendor/var ініціалізуються з прав цих тек образу (інакше docker створить їх root-ом і composer впаде)
RUN mkdir -p /app/vendor /app/var && chown -R "${UID}:${GID}" /app
USER app

WORKDIR /app
